#!/usr/bin/env bash
#
# Compiles the framework Sass to dist/, reproducing exactly what dartsass-rails
# produces in core (sass-embedded / Dart Sass, --style=compressed, no source map).
#
# Build targets mirror core's config/initializers/dartsass.rb (framework entries only).
#
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# Locate the Dart Sass binary shipped with the sass-embedded gem (same engine core uses).
if [ -n "${SASS_BIN:-}" ]; then
  SASS=( "$SASS_BIN" )
elif bundle exec sass --version >/dev/null 2>&1; then
  SASS=( bundle exec sass )
elif command -v sass >/dev/null 2>&1; then
  SASS=( sass )
else
  echo "error: no sass-embedded / sass binary found (run 'bundle install')" >&2
  exit 1
fi

OPTS=(--style=compressed --no-source-map --load-path=app/assets/stylesheets)

build() { # <input> <output>
  mkdir -p "$(dirname "$2")"
  "${SASS[@]}" "${OPTS[@]}" "$1" "$2"
  echo "  $1 -> $2 ($(wc -c < "$2" | tr -d ' ') bytes)"
}

SS=app/assets/stylesheets
echo "Building framework CSS with $("${SASS[@]}" --version)"
build "$SS/plugins.scss"                          dist/plugins.css
build "$SS/plugins_legacy.scss"                   dist/plugins_legacy.css
# The theme outputs are named per source file, so a deleted theme's compiled CSS would
# survive here as residue; every other target overwrites a fixed path. Start clean.
rm -rf dist/themes
for theme_scss in "$SS"/framework/themes/[a-z]*-theme.scss; do
  build "$theme_scss" "dist/themes/$(basename "$theme_scss" .scss).css"
done
build "$SS/framework/responsive_test.scss"        dist/framework/responsive_test.css

# JS runtime: plugins.js is a self-contained, hand-authored file (no bundler), so this
# dist copy is the readable source build. The release pipeline publishes the terser
# output with the version stamp as plugins.js, and needs `npm install`.
echo "Copying JS runtime"
mkdir -p dist/js
cp app/javascript/plugin-render/plugins.js dist/js/plugins.js
echo "  app/javascript/plugin-render/plugins.js -> dist/js/plugins.js ($(wc -c < dist/js/plugins.js | tr -d ' ') bytes)"
echo "Done."
