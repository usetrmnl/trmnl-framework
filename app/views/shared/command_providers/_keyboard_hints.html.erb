<%# Keyboard hints for Command Palette %>
<div class="flex items-center justify-between bg-gray-50 px-4 py-2.5 text-xs text-gray-700 dark:bg-gray-800 dark:text-gray-300"
     data-command-palette-target="keyboardHints">
  <div class="flex flex-wrap items-center gap-3">
    <span class="text-gray-500 dark:text-gray-600">Press</span>
    
    <%# Toggle shortcut %>
    <div class="flex items-center">
      <kbd class="<%= command_palette_class(:kbd) %>">⌘K</kbd>
      <span class="text-gray-700 dark:text-gray-500">to toggle</span>
    </div>
    
    <%# Navigation %>
    <div class="flex items-center">
      <kbd class="<%= command_palette_class(:kbd) %> min-w-[1.25rem]">↓↑</kbd>
      <span class="text-gray-700 dark:text-gray-500">to browse</span>
    </div>
    
    <%# Provider cycling %>
    <div class="flex items-center">
      <kbd class="<%= command_palette_class(:kbd) %>">tab</kbd>
      <span class="text-gray-700 dark:text-gray-500">to cycle providers</span>
    </div>
  </div>
</div>
