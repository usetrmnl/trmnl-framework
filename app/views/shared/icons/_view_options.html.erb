<%# "View" / display-options glyph: horizontal sliders (adjustments). Reads as
    "adjust the view" (list density + schedule visibility) and is visually distinct
    from the plain three-line drag handle used to reorder rows. %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
     class="flex-shrink-0 <%= local_assigns[:classes] || 'h-5 w-5' %>">
  <line x1="20" y1="7" x2="13" y2="7"/>
  <line x1="9" y1="7" x2="4" y2="7"/>
  <line x1="20" y1="17" x2="15" y2="17"/>
  <line x1="11" y1="17" x2="4" y2="17"/>
  <line x1="11" y1="5" x2="11" y2="9"/>
  <line x1="13" y1="15" x2="13" y2="19"/>
</svg>
