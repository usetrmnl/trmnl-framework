<%
  # Accept customization
  css_class ||= "w-[20px] h-[20px] flex-shrink-0"
  additional_classes ||= ""
  full_class = [css_class, additional_classes].compact.join(" ")
  data ||= {}

  attrs = {
    class: full_class,
    data: data
  }
%>
<svg <%= tag.attributes(attrs) %> aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
  <rect x="6" y="3" width="12" height="18" rx="2" ry="2"/>
</svg> 
