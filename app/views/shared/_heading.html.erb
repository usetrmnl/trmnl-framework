<% description ||= '' %>
<% type ||= 'h1' %>
<% show_back ||= false %>
<% center ||= false %>
<div class="relative">
    <% if type == 'h1' %>
      <h1 class="font-heading tracking-tight font-medium text-gray-900 dark:text-white text-2xl md:text-3xl mb-0.5 <%= 'text-center' if center %>"><%= title %></h1>
    <% elsif type == 'h2' %>
      <h2 class="<%= title_h2_classes %> <%= 'text-center' if center %>"><%= title %></h2>
    <% elsif type == 'h3' %>
      <h3 class="font-heading tracking-tight font-medium text-gray-900 dark:text-white text-lg md:text-xl mb-0.5 <%= 'text-center' if center %>"><%= title %></h3>
    <% elsif type == 'devise' %>
      <h2 class="text-center <%= title_h2_classes %>"><%= title %></h2>
    <% end %>
    <p class="max-w-96 text-md md:text-lg text-gray-500 leading-tight md:leading-tight <%= 'text-center' if center %> text-balance"><%= description.html_safe %></p>
</div>
