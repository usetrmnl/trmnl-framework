<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :flex %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <p class="text-gray-600 dark:text-gray-400">
      The Flex system provides utility classes for creating flexible layouts using Flexbox.
      It supports both row and column directions with various alignment, centering, and stretching options.
    </p>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Base Structure') %>
          <p class="<%= framework_section_description_classes %>">
            The Flex system provides two fundamental ways to organize content: horizontal (row) and vertical (column) arrangements.
            These base structures can be combined with alignment and stretch modifiers for complex layouts.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Row Direction') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">flex flex--row</code> to create a horizontal layout:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col gap">
                    <div class="flex flex--row border border-2 border-gray-300 border-dashed p-4 rounded-xl">
                      <div class="p-4 rounded-md bg-gray-100"><span class="label">Item 1</span></div>
                      <div class="p-4 rounded-md bg-gray-100"><span class="label">Item 2</span></div>
                      <div class="p-4 rounded-md bg-gray-100"><span class="label">Item 3</span></div>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Flex</span>
                    <span class="instance">Row Direction</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--row">
  {{ Item 1 }}
  {{ Item 2 }}
  {{ Item 3 }}
</div>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Column Direction') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">flex flex--col</code> to create a vertical layout:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--row gap">
                    <div class="flex flex--col border border-2 border-gray-300 border-dashed p-4 rounded-xl">
                      <div class="p-4 rounded-md bg-gray-100"><span class="label">Item 1</span></div>
                      <div class="p-4 rounded-md bg-gray-100"><span class="label">Item 2</span></div>
                      <div class="p-4 rounded-md bg-gray-100"><span class="label">Item 3</span></div>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Flex</span>
                    <span class="instance">Column Direction</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--col">
  {{ Item 1 }}
  {{ Item 2 }}
  {{ Item 3 }}
</div>'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
