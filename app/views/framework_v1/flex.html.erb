  <div>Normal item</div>
  <div class="stretch">Stretches in cross-axis</div>
</div>

<div class="flex flex--col">
  <div class="stretch-x">Stretches horizontally</div>
  <div>Normal item</div>
  <div class="stretch-x">Stretches horizontally</div>
</div>

<div class="flex flex--col">
  <div class="stretch-y">Stretches vertically</div>
  <div>Normal item</div>
  <div class="stretch-y">Stretches vertically</div>
</div>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Preventing Item Shrinkage') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">no-shrink</code> on flex children to prevent them from shrinking
              when other items try to take up more space:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col gap">
                    <!-- Without no-shrink -->
                    <div class="flex flex--row border border-2 border-gray-300 border-dashed p-4 rounded-xl w-full">
                      <div class="p-4 rounded-md bg-gray-100"><span class="label">Can Shrink</span></div>
                      <div class="p-4 rounded-md bg-gray-100 stretch"><span class="label">Stretching Content That Pushes Others</span></div>
                    </div>
                    <!-- With no-shrink -->
                    <div class="flex flex--row border border-2 border-gray-300 border-dashed p-4 rounded-xl w-full">
                      <div class="p-4 rounded-md bg-gray-100 no-shrink"><span class="label">Won't Shrink</span></div>
                      <div class="p-4 rounded-md bg-gray-100 stretch"><span class="label">Stretching Content That Pushes Others</span></div>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Flex</span>
                    <span class="instance">Prevent Shrinking</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--row">
  <div class="no-shrink">Maintains its width</div>
  <div class="stretch">Stretches but won\'t squish the no-shrink item</div>
</div>'
            ) %>
          </div>
        </div>
      </section>

      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
