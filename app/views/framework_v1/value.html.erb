<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :value %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <p class="text-gray-600 dark:text-gray-400">
      The Value system provides consistent text styling for displaying numerical and textual values, with various size options
      and support for tabular numbers. It ensures readability and visual hierarchy across different contexts.
    </p>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Size Variants') %>
          <p class="<%= framework_section_description_classes %>">
            The Value system offers eight size variants, from XXSmall to XXXLarge, allowing for flexible typography scaling
            across different use cases. Each size is carefully crafted for optimal readability and visual balance.
          </p>
        </div>

        <!-- XXSmall -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'XXSmall') %>
            <p class="<%= framework_subsection_description_classes %>">
              The <code class="<%= framework_section_code_classes %>">value--xxsmall</code> class creates the smallest text size,
              ideal for compact displays and supporting information.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col gap--large">
                    <span class="value value--xxsmall">Example</span>
                    <span class="value value--xxsmall value--tnums">48,206.62</span>
                  </div>
                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Value</span>
                    <span class="instance">XXSmall</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<span class="value value--xxsmall">Example</span>
<span class="value value--xxsmall value--tnums">48,206.62</span>'
            ) %>
          </div>
        </div>

        <!-- XSmall -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'XSmall') %>
            <p class="<%= framework_subsection_description_classes %>">
              The <code class="<%= framework_section_code_classes %>">value--xsmall</code> class provides a size slightly larger than XXSmall,
              suitable for secondary information and compact interfaces.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
