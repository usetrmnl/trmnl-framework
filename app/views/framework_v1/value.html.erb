          <%= framework_heading(3, 'Numerical Display') %>
          <p class="<%= framework_section_description_classes %>">
            For numerical values, the Value system includes special formatting options to ensure clear and consistent display
            of numbers, particularly in financial or data-heavy contexts.
          </p>
        </div>

        <!-- Tabular Numbers -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Tabular Numbers') %>
            <p class="<%= framework_subsection_description_classes %>">
              Add the <code class="<%= framework_section_code_classes %>">value--tnums</code> modifier to enable
              tabular numbers, ensuring consistent width for better alignment in tables and lists.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col gap--large">
                    <span class="value value--large">Regular: 48,206.62</span>
                    <span class="value value--large value--tnums">Tabular: 48,206.62</span>
                  </div>
