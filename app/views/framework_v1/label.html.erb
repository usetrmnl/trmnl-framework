<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :label %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <p class="text-gray-600 dark:text-gray-400">
      The Label system provides various styles for displaying text labels, with options for different visual treatments
      and sizes. Labels can be used to highlight text, show status, or create visual hierarchy in your interface.
    </p>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Label Variants') %>
          <p class="<%= framework_section_description_classes %>">
            Labels come in several variants to suit different use cases. Each variant provides a distinct visual style
            while maintaining consistent spacing and sizing.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Default Labels') %>
            <p class="<%= framework_subsection_description_classes %>">
              The base label styles and their variants provide different ways to present text, from solid backgrounds
              to outlined and underlined versions.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col gap--large">
                    <span class="label">Label</span>
                    <span class="label label--outline">Outline Label</span>
                    <span class="label label--underline">Underline Label</span>
                    <span class="label label--gray-out">Gray Out Label</span>
                    <span class="label label--inverted">Inverted Label</span>
                  </div>
                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Label</span>
                    <span class="instance">Default</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<span class="label">Label</span>
<span class="label label--outline">Outline Label</span>
<span class="label label--underline">Underline Label</span>
<span class="label label--gray-out">Gray Out Label</span>
<span class="label label--inverted">Inverted Label</span>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Small Labels') %>
            <p class="<%= framework_subsection_description_classes %>">
              Add the <code class="<%= framework_section_code_classes %>">label--small</code> class
              to create a more compact version of any label variant.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col gap--large">
                    <span class="label label--small">Label</span>
                    <span class="label label--small label--outline">Outline Label</span>
                    <span class="label label--small label--underline">Underline Label</span>
                    <span class="label label--small label--gray-out">Gray Out Label</span>
                    <span class="label label--small label--inverted">Inverted Label</span>
                  </div>
                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Label</span>
                    <span class="instance">Small</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<span class="label label--small">Label</span>
<span class="label label--small label--outline">Outline Label</span>
<span class="label label--small label--underline">Underline Label</span>
<span class="label label--small label--gray-out">Gray Out Label</span>
<span class="label label--small label--inverted">Inverted Label</span>'
            ) %>
          </div>
        </div>
      </section>
      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
