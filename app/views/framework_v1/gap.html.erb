<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :gap %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <p class="text-gray-600 dark:text-gray-400">
      The Gap system provides consistent spacing between elements using CSS gap property. It offers predefined sizes,
      responsive spacing, and custom values to maintain visual rhythm throughout your interface.
    </p>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Base Sizes') %>
          <p class="<%= framework_section_description_classes %>">
            The gap system includes seven predefined sizes, from xsmall to xxlarge. These standardized spaces
            help maintain consistent spacing across your application's grid and flex layouts.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Standard Gaps') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">gap--xsmall</code> for tight spacing,
              <code class="<%= framework_section_code_classes %>">gap</code> for default spacing, and larger
              variants for more generous spacing needs.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col">
                    <div class="grid grid--col-3 gap--xsmall">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xsmall</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xsmall</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xsmall</span>
                      </div>
                    </div>
                    <div class="grid grid--col-3 gap--small">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--small</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--small</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--small</span>
                      </div>
                    </div>
                    <div class="grid grid--col-3 gap">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap</span>
                      </div>
                    </div>
                    <div class="grid grid--col-3 gap--medium">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--medium</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--medium</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--medium</span>
                      </div>
                    </div>
                    <div class="grid grid--col-3 gap--large">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--large</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--large</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--large</span>
                      </div>
                    </div>
                    <div class="grid grid--col-3 gap--xlarge">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xlarge</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xlarge</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xlarge</span>
                      </div>
                    </div>
                    <div class="grid grid--col-3 gap--xxlarge">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xxlarge</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xxlarge</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--xxlarge</span>
                      </div>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Predefined Gaps</span>
                    <span class="instance">Design System</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<!-- Available gap sizes from smallest to largest -->
<div class="grid grid--col-3 gap--xsmall">...</div>
<div class="grid grid--col-3 gap--small">...</div>
<div class="grid grid--col-3 gap">...</div>
<div class="grid grid--col-3 gap--medium">...</div>
<div class="grid grid--col-3 gap--large">...</div>
<div class="grid grid--col-3 gap--xlarge">...</div>
<div class="grid grid--col-3 gap--xxlarge">...</div>'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Distribution Modifiers') %>
          <p class="<%= framework_section_description_classes %>">
            Beyond fixed gaps, you can use special modifiers to control how space is distributed between elements.
            These modifiers are particularly useful for creating flexible, dynamic layouts.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Space Between') %>
            <p class="<%= framework_subsection_description_classes %>">
              The <code class="<%= framework_section_code_classes %>">gap--space-between</code> modifier
              distributes available space evenly between elements, pushing them to the edges of their container.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col">
                    <div class="flex flex--col gap--space-between h-full">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--space-between</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--space-between</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--space-between</span>
                      </div>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Space Between Gap</span>
                    <span class="instance">Design System</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<!-- Space between elements in a flex container -->
<div class="flex flex--col gap--space-between h-full">
  <div>First item</div>
  <div>Second item</div>
  <div>Third item</div>
</div>'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Custom Values') %>
          <p class="<%= framework_section_description_classes %>">
            When predefined gaps don't meet your specific needs, you can use custom pixel values. This provides
            precise control over spacing while maintaining the consistent gap syntax.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Arbitrary Pixel Values') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">gap--[Npx]</code> syntax to specify
              exact pixel values. This works with both grid and flex layouts.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col">
                    <div class="grid grid--col-3 gap--[5px]">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[5px]</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[5px]</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[5px]</span>
                      </div>
                    </div>
                    <div class="grid grid--col-3 gap--[10px]">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[10px]</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[10px]</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[10px]</span>
                      </div>
                    </div>
                    <div class="grid grid--col-3 gap--[15px]">
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[15px]</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[15px]</span>
                      </div>
                      <div class="border border-2 border-gray-300 border-dashed p-2.5 rounded-xl">
                        <span class="label">gap--[15px]</span>
                      </div>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Custom Pixel Gaps</span>
                    <span class="instance">Design System</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<!-- Custom gap values -->
<div class="grid grid--col-3 gap--[5px]">...</div>
<div class="grid grid--col-3 gap--[10px]">...</div>
<div class="grid grid--col-3 gap--[15px]">...</div>

<!-- Works with flex containers too -->
<div class="flex flex--col gap--[20px]">...</div>'
            ) %>
          </div>
        </div>
      </section>
      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
