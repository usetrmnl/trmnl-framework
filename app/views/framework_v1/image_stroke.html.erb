<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :image_stroke %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <p class="text-gray-600 dark:text-gray-400">
      The Image Stroke system allows you to add an outline to a vector or transparent raster images with customizable stroke width and color. This is useful for creating images that stand out against shaded backgrounds.
    </p>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Usage') %>
          <p class="<%= framework_section_description_classes %>">
            The Image Stroke system includes preset size modifiers that allow you to quickly apply different stroke widths to your images. The default stroke is 1.5px white, with additional options for small (1px), medium (2px), large (2.5px), and extra large (3px).
          </p>
        </div>

        <div class="space-y-6">
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col gap">
                    <div class="flex flex--col gap--4 bg--gray-6 p--6 rounded-lg">
                      <div class="flex flex--row flex--center stretch-x">
                        <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                          <%= image_tag "trmnl--glyph-black.svg", class: "w--16 h--16" %>
                          <span class="label">No Stroke</span>
                        </div>
                        <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                          <%= image_tag "trmnl--glyph-black.svg", class: "image-stroke image-stroke--small w--16 h--16" %>
                          <span class="label text-stroke text-stroke--small">Small</span>
                        </div>
                        <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                          <%= image_tag "trmnl--glyph-black.svg", class: "image-stroke w--16 h--16" %>
                          <span class="label text-stroke">Default</span>
                        </div>
                        <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                          <%= image_tag "trmnl--glyph-black.svg", class: "image-stroke image-stroke--medium w--16 h--16" %>
                          <span class="label text-stroke text-stroke--medium">Medium</span>
                        </div>
                        <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                          <%= image_tag "trmnl--glyph-black.svg", class: "image-stroke image-stroke--large w--16 h--16" %>
                          <span class="label text-stroke text-stroke--large">Large</span>
                        </div>
                        <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                          <%= image_tag "trmnl--glyph-black.svg", class: "image-stroke image-stroke--xlarge w--16 h--16" %>
                          <span class="label text-stroke text-stroke--xlarge">Extra Large</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Image Stroke</span>
                    <span class="instance">Preset Sizes</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<img src="/images/trmnl--glyph-black.svg">
<img class="image-stroke image-stroke--small" src="/images/trmnl--glyph-black.svg">
<img class="image-stroke" src="/images/trmnl--glyph-black.svg">
<img class="image-stroke image-stroke--medium" src="/images/trmnl--glyph-black.svg">
<img class="image-stroke image-stroke--large" src="/images/trmnl--glyph-black.svg">
<img class="image-stroke image-stroke--xlarge" src="/images/trmnl--glyph-black.svg">'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Stroke Colors') %>

          <p class="<%= framework_section_description_classes %>">
            Use the black modifier for images on dark backgrounds.
          </p>
        </div>

        <div class="space-y-6">
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col gap">
                    <div class="richtext">
                      <div class="content gap--large bg--gray-2 p--6 rounded-lg">
                        <div class="flex flex--col gap--4">
                          <div class="flex flex--row flex--center stretch-x">
                            <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                              <%= image_tag "trmnl--glyph-white.svg", class: "w--16 h--16" %>
                              <span class="label text--white">No Stroke</span>
                            </div>
                            <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                              <%= image_tag "trmnl--glyph-white.svg", class: "image-stroke image-stroke--black image-stroke--small w--16 h--16" %>
                              <span class="label text-stroke text-stroke--black text--white text-stroke--small">Small</span>
                            </div>
                            <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                              <%= image_tag "trmnl--glyph-white.svg", class: "image-stroke image-stroke--black w--16 h--16" %>
                              <span class="label text-stroke text-stroke--black text--white">Default</span>
                            </div>
                            <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                              <%= image_tag "trmnl--glyph-white.svg", class: "image-stroke image-stroke--black image-stroke--medium w--16 h--16" %>
                              <span class="label text-stroke text-stroke--black text--white text-stroke--medium">Medium</span>
                            </div>
                            <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                              <%= image_tag "trmnl--glyph-white.svg", class: "image-stroke image-stroke--black image-stroke--large w--16 h--16" %>
                              <span class="label text-stroke text-stroke--black text--white text-stroke--large">Large</span>
                            </div>
                            <div class="flex flex--col flex--center h--[102px] w--[102px] stretch">
                              <%= image_tag "trmnl--glyph-white.svg", class: "image-stroke image-stroke--black image-stroke--xlarge w--16 h--16" %>
                              <span class="label text-stroke text-stroke--black text--white text-stroke--xlarge">Extra Large</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                    <span class="title">Image Stroke</span>
                    <span class="instance">Color Variants</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<img src="/images/trmnl--glyph-white.svg">
<img class="image-stroke image-stroke--black image-stroke--small" src="/images/trmnl--glyph-white.svg">
<img class="image-stroke image-stroke--black" src="/images/trmnl--glyph-white.svg">
<img class="image-stroke image-stroke--black image-stroke--medium" src="/images/trmnl--glyph-white.svg">
<img class="image-stroke image-stroke--black image-stroke--large" src="/images/trmnl--glyph-white.svg">
<img class="image-stroke image-stroke--black image-stroke--xlarge" src="/images/trmnl--glyph-white.svg">'
            ) %>
          </div>
        </div>
      </section>

      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
