<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :colors %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:colors) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Grayscale Palette') %>
          <p class="<%= framework_section_description_classes %>">
            The complete range of grayscale shades available in the framework, from pure black to pure white. These tokens use the same lightness scale as chromatic and blend palettes.
          </p>
        </div>

        <div class="trmnl framework-inline-demo">
          <div class="screen p-0 bg-transparent h--auto w--auto">
            <div class="grid grid-cols-3 xs:grid-cols-4 sm:grid-cols-4 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-8 gap-4">
              <% %w[black gray-10 gray-15 gray-20 gray-25 gray-30 gray-35 gray-40 gray-45 gray-50 gray-55 gray-60 gray-65 gray-70 gray-75 white].each do |shade| %>
                <div class="flex flex-col gap-2">
                  <div class="relative w-full pb-[100%]">
                    <div class="absolute inset-0 rounded-lg bg--<%= shade %>"></div>
                  </div>
                  <div class="text-center">
                    <div class="text-sm font-medium text-gray-600 dark:text-gray-500"><%= shade.gsub('gray-', '') %></div>
                    <div class="text-xs text-gray-500 dark:text-gray-600"><%= shade %></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="dark-mode-notice hidden <%= message_sage_classes %>">
          <div class="flex items-center w-full">
            <div class="flex-shrink-0 items-center">
              <%= render 'shared/icons/info' %>
            </div>
            <div class="w-full flex items-center justify-between ml-3">
              <p class="text-sm font-medium">
                <strong>Dark Mode Notice:</strong> The color palette appears inverted because TRMNL's dark mode inverts the entire screen, except the images.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Chromatic Palette') %>
          <p class="<%= framework_section_description_classes %>">
            The framework offers 10 hues × 14 lightness steps (red, orange, yellow, lime, green, cyan, blue, violet, purple, pink), using the same steps as grayscale (10, 15, 20, …, 75). Select a color device (e.g. Inky Impression 7.3, Tidbyt) from the Device Preview above to see these colors in action. Use the Raw Colors / Preview Colors toggle to compare full-bright tokens vs device-representative rendering.
          </p>
        </div>

        <div class="trmnl framework-inline-demo">
          <div class="screen p-0 bg-transparent h--auto w--auto">
            <div class="space-y-6 w-full">
              <% steps_before = [10, 15, 20, 25, 30, 35, 40] %>
              <% steps_after = [45, 50, 55, 60, 65, 70, 75] %>
              <% %w[red orange yellow lime green cyan blue violet purple pink].each do |hue| %>
                <div>
                  <div class="text-sm font-medium text-gray-600 dark:text-gray-500 mb-2 capitalize"><%= hue %></div>
                  <div class="grid grid-cols-8 sm:grid-cols-[repeat(15,minmax(0,1fr))] gap-4">
                    <% steps_before.each do |step| %>
                      <div class="flex flex-col gap-2">
                        <div class="relative w-full pb-[100%]">
                          <div class="absolute inset-0 rounded-lg bg--<%= hue %>-<%= step %>"></div>
                        </div>
                        <div class="text-center">
                          <div class="text-xs text-gray-500 dark:text-gray-600"><%= hue %>-<%= step %></div>
                        </div>
                      </div>
                    <% end %>
                    <div class="flex flex-col gap-2">
                      <div class="relative w-full pb-[100%]">
                        <div class="absolute inset-0 rounded-lg bg--<%= hue %>"></div>
                      </div>
                      <div class="text-center">
                        <div class="text-xs text-gray-500 dark:text-gray-600 font-medium"><%= hue %></div>
                      </div>
                    </div>
                    <% steps_after.each do |step| %>
                      <div class="flex flex-col gap-2">
                        <div class="relative w-full pb-[100%]">
                          <div class="absolute inset-0 rounded-lg bg--<%= hue %>-<%= step %>"></div>
                        </div>
                        <div class="text-center">
                          <div class="text-xs text-gray-500 dark:text-gray-600"><%= hue %>-<%= step %></div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="<%= framework_section_description_classes %>">
          <strong>Device Preview tip:</strong> Use the Device Preview (top right) to switch between grayscale and color palettes, then toggle Raw Colors / Preview Colors to compare full-bright and device-accurate previews. Try Inky Impression 7.3 (color-7a) or Tidbyt (color-24bit) to see chromatic colors.
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Semantic Colors') %>
          <p class="<%= framework_section_description_classes %>">
            Semantic color roles map meaning to base hues. Use <code class="<%= framework_section_code_classes %>">bg--primary</code>, <code class="<%= framework_section_code_classes %>">text--success</code>, and similar utilities for intent-based styling. These alias underlying tokens (e.g. primary → blue) and inherit all device/bit-depth behavior. Themes can override via <code class="<%= framework_section_code_classes %>">--color-{role}</code> CSS variables.
          </p>
        </div>

        <div class="trmnl framework-inline-demo">
          <div class="screen p-0 bg-transparent h--auto w--auto">
            <div class="grid grid-cols-2 xs:grid-cols-3 sm:grid-cols-6 gap-4">
              <% { primary: 'blue', success: 'green', error: 'red', warning: 'orange' }.each do |role, token| %>
                <div class="flex flex-col gap-2">
                  <div class="relative w-full pb-[100%]">
                    <div class="absolute inset-0 rounded-lg bg--<%= role %>"></div>
                  </div>
                  <div class="text-center">
                    <div class="text-sm font-medium text-gray-600 dark:text-gray-500"><%= role.to_s.capitalize %></div>
                    <div class="text-xs text-gray-500 dark:text-gray-600">bg--<%= role %></div>
                    <div class="text-xs text-gray-500 dark:text-gray-600">→ <%= token %></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="<%= framework_docs_table_wrapper_classes %>">
          <div class="<%= framework_docs_table_card_classes %>">
            <table class="<%= framework_docs_table_classes %>">
            <thead>
              <tr>
                <th class="<%= framework_docs_table_header_cell_classes %>">Role</th>
                <th class="<%= framework_docs_table_header_cell_classes %>">Underlying Token</th>
                <th class="<%= framework_docs_table_header_cell_classes %>">Use</th>
              </tr>
            </thead>
            <tbody class="<%= framework_docs_table_body_classes %>">
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">primary</td>
                <td class="px-6 py-4 text-sm"><code class="<%= framework_section_code_classes %>">blue</code></td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">Main actions, accents</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">success</td>
                <td class="px-6 py-4 text-sm"><code class="<%= framework_section_code_classes %>">green</code></td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">Confirmations, positive states</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">error</td>
                <td class="px-6 py-4 text-sm"><code class="<%= framework_section_code_classes %>">red</code></td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">Errors, destructive actions</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">warning</td>
                <td class="px-6 py-4 text-sm"><code class="<%= framework_section_code_classes %>">orange</code></td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">Cautions, alerts</td>
              </tr>
            </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Token Syntax') %>
          <p class="<%= framework_section_description_classes %>">
            Apply these color tokens with utility prefixes. The <%= link_to 'Background', framework_docs_background_path, class: 'font-medium hover:underline' %> page documents <code class="<%= framework_section_code_classes %>">bg--{token}</code>; the <%= link_to 'Text Color', framework_docs_text_color_path, class: 'font-medium hover:underline' %> page documents <code class="<%= framework_section_code_classes %>">text--{token}</code>. Other utilities (border, outline, etc.) may use the same tokens where applicable.
          </p>
        </div>

        <div class="<%= framework_docs_table_wrapper_classes %>">
          <div class="<%= framework_docs_table_card_classes %>">
            <table class="<%= framework_docs_table_classes %>">
            <thead>
              <tr>
                <th class="<%= framework_docs_table_header_cell_classes %>">Utility</th>
                <th class="<%= framework_docs_table_header_cell_classes %>">Example</th>
                <th class="<%= framework_docs_table_header_cell_classes %>">Use</th>
              </tr>
            </thead>
            <tbody class="<%= framework_docs_table_body_classes %>">
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">bg--</td>
                <td class="px-6 py-4 text-sm"><code class="<%= framework_section_code_classes %>">bg--gray-50</code>, <code class="<%= framework_section_code_classes %>">bg--red-40</code></td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">Background colors</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">text--</td>
                <td class="px-6 py-4 text-sm"><code class="<%= framework_section_code_classes %>">text--gray-50</code>, <code class="<%= framework_section_code_classes %>">text--blue-60</code>, <code class="<%= framework_section_code_classes %>">text--success</code></td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">Text colors</td>
              </tr>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">bg-- / text-- (semantic)</td>
                <td class="px-6 py-4 text-sm"><code class="<%= framework_section_code_classes %>">bg--primary</code>, <code class="<%= framework_section_code_classes %>">text--error</code>, <code class="<%= framework_section_code_classes %>">text--success</code></td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">Semantic roles (primary, success, error, warning)</td>
              </tr>
            </tbody>
            </table>
          </div>
        </div>

        <p class="<%= framework_section_description_classes %>">
          <strong>Grayscale:</strong> black, gray-10 through gray-75, white.
          <strong>Chromatic:</strong> <code class="<%= framework_section_code_classes %>">{hue}</code> (pure color) or <code class="<%= framework_section_code_classes %>">{hue}-{step}</code> (e.g. red-50, blue-40).
          <strong>Blend:</strong> <code class="<%= framework_section_code_classes %>">{colorA}-{colorB}-{step}</code> (e.g. red-blue-50, green-yellow-25).
          <strong>Semantic:</strong> <code class="<%= framework_section_code_classes %>">primary</code>, <code class="<%= framework_section_code_classes %>">success</code>, <code class="<%= framework_section_code_classes %>">error</code>, <code class="<%= framework_section_code_classes %>">warning</code> (alias base hues).
        </p>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Backward Compatibility') %>
          <p class="<%= framework_section_description_classes %>">
            For backward compatibility, the original shade names (<code class="<%= framework_section_code_classes %>">gray-1</code> through <code class="<%= framework_section_code_classes %>">gray-7</code>) are still supported but deprecated. These map to equivalent extended shades:
          </p>
        </div>

        <div class="<%= framework_example_classes %> trmnl framework-inline-demo">
          <div class="<%= framework_example_inner_classes %>">
            <div class="screen p-0 bg-transparent h--auto w--auto">
              <div class="grid grid-cols-7 gap-4">
                <% (1..7).each do |n| %>
                  <div class="flex flex-col gap-2">
                    <div class="relative w-full pb-[100%]">
                      <div class="absolute inset-0 rounded-lg bg--gray-<%= n %>"></div>
                    </div>
                    <div class="text-center">
                      <div class="text-sm font-medium text-gray-600 dark:text-gray-500">gray-<%= n %> (deprecated)</div>
                      <div class="text-xs text-gray-500 dark:text-gray-600">gray-<%= n %></div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(
            demo_code: '<!-- Deprecated (but still works) -->
<div class="bg--gray-1">Gray 1</div>
<div class="bg--gray-2">Gray 2</div>

<!-- Preferred (new naming) -->
<div class="bg--gray-10">Gray 10</div>
<div class="bg--gray-20">Gray 20</div>'
          ) %>
        </div>
      </section>
      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
