<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :chart %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:chart) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Usage') %>
          <p class="<%= framework_section_description_classes %>">
            Any CDN-enabled JavaScript library may be used to develop charting interfaces,
            however the examples below leverage <%= link_to 'Highcharts', 'https://highcharts.com', target: :_blank, class: 'underline' %>
            and <%= link_to 'Chartkick', 'https://chartkick.com', target: :_blank, class: 'underline' %>.
          </p>

          <p class="<%= framework_section_description_classes %>">
            If you set the <code class="<%= framework_section_code_classes %>">height: null</code> within your highchart's settings, the chart will automatically expand to fill the available space.
          </p>

          <div class="<%= message_warning_classes %>">
            <div class="flex items-center w-full">
              <div class="flex-shrink-0 items-center">
                <%= render 'shared/icons/warning' %>
              </div>
              <div class="w-full flex items-center justify-between ml-3">
                <p class="leading-none text-sm font-medium">
                  Take care to disable animation effects, otherwise your chart may be only partially captured by TRMNL's screenshot rendering service.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Line Chart') %>
