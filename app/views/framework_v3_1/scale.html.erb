                    <code class="text-sm font-mono text-syntax-string">screen screen--v2 screen--scale-small</code>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    Uses 87.5% content scale and 87.5% of the device UI scale
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <code class="text-sm font-mono text-syntax-string">screen screen--amazon_kindle_2024 screen--scale-large</code>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    Uses 112.5% content scale and 112.5% of the device UI scale
                  </td>
                </tr>
              </tbody>
              </table>
            </div>
          </div>

          <div class="mt-4">
