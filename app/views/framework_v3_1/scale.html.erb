<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :scale %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:scale) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Basic Usage') %>
          <p class="<%= framework_section_description_classes %>">
            Apply scale modifiers to the <code class="<%= framework_section_code_classes %>">screen</code> element to scale all interface elements proportionally.
            The selected scale changes typography, component dimensions, gaps, and pixel-based utilities while leaving screen dimensions and relative units unchanged. Scale is available on 4bit devices.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Available Scale Levels') %>
            <p class="<%= framework_subsection_description_classes %>">
              The framework provides seven predefined scale levels:
            </p>
          </div>

          <div class="<%= framework_docs_table_wrapper_classes %>">
            <div class="<%= framework_docs_table_card_classes %>">
              <table class="<%= framework_docs_table_classes %>">
              <thead>
                <tr>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Class</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Scale Factor</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Use Case</th>
                </tr>
              </thead>
              <tbody class="<%= framework_docs_table_body_classes %>">
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <code class="text-sm font-mono text-syntax-string">screen--scale-xxsmall</code>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                    0.66 (66%)
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    Dynamic mashup content density
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <code class="text-sm font-mono text-syntax-string">screen--scale-xsmall</code>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                    0.75 (75%)
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    Maximum content density
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <code class="text-sm font-mono text-syntax-string">screen--scale-small</code>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                    0.875 (87.5%)
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    Increased content density
                  </td>
                </tr>
                <tr>
