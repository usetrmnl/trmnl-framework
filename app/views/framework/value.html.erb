<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :value %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:value) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Size Variants') %>
          <p class="<%= framework_section_description_classes %>">
            The Value system offers twelve size variants, from XXSmall to Peta.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Size Ladder') %>
            <p class="<%= framework_subsection_description_classes %>">
              Each tier maps to one font size, and that size holds on every device, bit depth, and font bundle.
              A bare <code class="<%= framework_section_code_classes %>">value</code> renders at the Base tier.
              <%= render DocsRef.new(page: :scale) %> and <%= render DocsRef.new(page: :text_scale) %> multiply these sizes from the screen.
            </p>
          </div>

          <div class="<%= framework_docs_table_wrapper_classes %>">
            <div class="<%= framework_docs_table_card_classes %>">
              <table class="<%= framework_docs_table_classes %>">
                <thead>
                  <tr>
                    <th class="<%= framework_docs_table_header_cell_classes %>">Class</th>
                    <th class="<%= framework_docs_table_header_cell_classes %>">Font size</th>
                  </tr>
                </thead>
                <tbody class="<%= framework_docs_table_body_classes %>">
                  <% [
                    ['value--xxsmall',  '16px'],
                    ['value--xsmall',   '20px'],
                    ['value--small',    '26px'],
                    ['value--base',     '38px'],
                    ['value--large',    '58px'],
                    ['value--xlarge',   '74px'],
                    ['value--xxlarge',  '96px'],
                    ['value--xxxlarge', '128px'],
                    ['value--mega',     '170px'],
                    ['value--giga',     '220px'],
                    ['value--tera',     '290px'],
                    ['value--peta',     '380px']
                  ].each do |class_name, size| %>
                    <tr>
                      <td class="px-6 py-4 whitespace-nowrap text-sm">
                        <code class="text-sm font-mono text-syntax-string"><%= class_name %></code>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100"><%= size %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="<%= message_sage_classes %>">
            <div class="flex items-center w-full">
              <div class="flex-shrink-0 items-center">
                <%= render 'shared/icons/info' %>
              </div>
              <div class="w-full flex items-center justify-between ml-3">
                <p class="text-sm font-medium">
                  Value and the <code class="font-mono">text--</code> utilities share tier names but not sizes.
                  <code class="font-mono">value--xlarge</code> is 74px where <code class="font-mono">text--xlarge</code> is 26px, and the utility that matches <code class="font-mono">value--xlarge</code> is <code class="font-mono">text--mega</code>.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- XXSmall -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'XXSmall') %>
            <p class="<%= framework_subsection_description_classes %>">
              The <code class="<%= framework_section_code_classes %>">value--xxsmall</code> class creates the smallest text size.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap--large">
                      <span class="value value--xxsmall">Example</span>
                      <span class="value value--xxsmall value--tnums">48,206.62</span>
                    </div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Value</span>
                      <span class="instance">XXSmall</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

