<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :content_limiter %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <% richtext_content = content_limiter_examples[:dinner_party] %>
    <%= render_framework_intro_paragraph(:content_limiter) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Basic usage') %>
          <p class="<%= framework_section_description_classes %>">
            To enable automatic content limiting, add the <code class="<%= framework_section_code_classes %>">data-content-limiter="true"</code> attribute to your content element.
          </p>
        </div>

        <div class="space-y-6">
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout">
                      <div class="columns">
                        <div class="column">
                          <div class="richtext gap--large">
                            <%= content_limiter_examples[:dinner_party] %>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Content Limiter</span>
                      <span class="instance">Text Exceeding Threshold</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="<%= framework_example_classes %> mt-6">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout">
                      <div class="columns">
                        <div class="column">
                          <div class="richtext gap--large">
                            <%= content_limiter_short_example[:best_boss] %>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Content Limiter</span>
                      <span class="instance">Text Within Threshold</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="content" data-content-limiter="true">
  <p>Contrary to what one might think, the Lorem ipsum text, despite being meaningless, has noble...</p>
</div>'
            ) %>
          </div>

          <div class="space-y-4">
            <p class="<%= framework_section_description_classes %>">
              When content exceeds the height threshold, the limiter adds the <code class="<%= framework_section_code_classes %>">content--small</code> class and automatically truncates the first overflowing block using the Clamp Engine <%= render DocsRef.new(page: :clamp) %> so it fits the remaining space. Subsequent blocks are hidden.
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Custom Height Threshold') %>
          <p class="<%= framework_section_description_classes %>">
            You can specify a custom maximum height using the <code class="<%= framework_section_code_classes %>">data-content-max-height</code> attribute.
          </p>
        </div>

        <div class="space-y-6">
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout">
                      <div class="columns">
                        <div class="column gap--xxlarge">
                          <div class="richtext gap--large">
                            <%= content_limiter_examples_with_max_height(140)[:george_foreman] %>
                          </div>
                          <div class="richtext gap--large">
                            <%= content_limiter_examples_with_max_height(140)[:prison_mike] %>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Content Limiter</span>
                      <span class="instance">Custom Max Height: 140px</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="content" data-content-limiter="true" data-content-max-height="140">
  <p>Contrary to what one might think, the Lorem ipsum text, despite being meaningless, has noble...</p>
</div>

<div class="content" data-content-limiter="true" data-content-max-height="140">
  <p>Contrary to what one might think, the Lorem ipsum text, despite being meaningless, has noble...</p>
</div>
'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Mashup Example') %>
          <p class="<%= framework_section_description_classes %>">
            This demonstrates content limiting within a multi-view mashup.
          </p>
        </div>

        <div class="space-y-6">
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="mashup mashup--2Lx1R">
                    <div class="view view--quadrant">
                      <div class="layout">
                        <div class="columns">
                          <div class="column">
                            <div class="richtext gap">
                              <%= content_limiter_examples[:cpr_training] %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="view view--quadrant">
                      <div class="layout">
                        <div class="columns">
                          <div class="column">
                            <div class="richtext gap">
                              <%= content_limiter_examples[:bankruptcy] %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="view view--half_vertical">
                      <div class="layout">
                        <div class="columns">
                          <div class="column">
                            <div class="richtext gap">
                              <%= content_limiter_examples[:scotts_tots] %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
