                      if (++tries > 200) return;
                      setTimeout(attempt, 50);
                    })();
                  }

                  function clock(seconds) {
                    var m = Math.floor(seconds / 60), s = Math.round(seconds % 60);
                    return m + ":" + (s < 10 ? "0" : "") + s;
                  }

                  whenReady(function () {
