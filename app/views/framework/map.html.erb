</script>') %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Map styles') %>
            <p class="<%= framework_subsection_description_classes %>">
              The same view through three presets. Streets is the full map, minimal keeps the shapes a route sits
              on, and outline is coast, water, main roads and the big names for the smallest views.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <script data-trmnl-src="/framework-docs/maplibre-gl-5.24.0.js"></script>
                  <link data-trmnl-href="/framework-docs/maplibre-gl-5.24.0.css" rel="stylesheet">

                  <div class="view view--full">
                    <div class="layout layout--col gap--small">
                      <div class="columns stretch">
                        <div class="column stretch">
                          <div class="layout layout--col gap--xsmall stretch">
                            <div id="map-style-streets" class="map stretch w--full"></div>
                            <span class="label label--small">streets</span>
                          </div>
                        </div>
                        <div class="column stretch">
                          <div class="layout layout--col gap--xsmall stretch">
                            <div id="map-style-minimal" class="map stretch w--full"></div>
                            <span class="label label--small">minimal</span>
                          </div>
                        </div>
                        <div class="column stretch">
                          <div class="layout layout--col gap--xsmall stretch">
                            <div id="map-style-outline" class="map stretch w--full"></div>
                            <span class="label label--small">outline</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <img class="image image--adaptive" src="/images/plugins/trmnl--render.svg" alt="TRMNL Logo">
                      <span class="title">Map</span>
                      <span class="instance">Styles</span>
                    </div>
                  </div>

                  <script type="text/trmnl-example">
                    function whenReady(cb) {
                      var tries = 0;
                      (function attempt() {
                        if (window.TRMNLMaps && window.maplibregl) return cb();
                        if (++tries > 200) return;
                        setTimeout(attempt, 50);
                      })();
                    }

                    whenReady(function () {
                      ["streets", "minimal", "outline"].forEach(function (preset) {
                        var el = "map-style-" + preset;
                        TRMNLMaps.watch(el, function () {
                          return new maplibregl.Map(TRMNLMaps.options({
                            el: el, preset: preset, center: [2.3522, 48.8566], zoom: 12
                          }));
                        });
                      });
                    });
                  </script>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(demo_code: '// One watch() per container; only the preset changes.
["streets", "minimal", "outline"].forEach(function (preset) {
  var el = "map-style-" + preset;
  TRMNLMaps.watch(el, function () {
    return new maplibregl.Map(TRMNLMaps.options({
      el: el, preset: preset, center: [2.3522, 48.8566], zoom: 12
    }));
  });
});', language: 'javascript') %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Markers and routes') %>
            <p class="<%= framework_subsection_description_classes %>">
              Plot your own data as GeoJSON sources. path() and marker() hand you the layer paint from the screen's
              chart-series ramp, and fit() frames the route on an integer zoom.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <script data-trmnl-src="/framework-docs/maplibre-gl-5.24.0.js"></script>
                  <link data-trmnl-href="/framework-docs/maplibre-gl-5.24.0.css" rel="stylesheet">

                  <div class="view view--full">
                    <div class="layout layout--col gap--small">
                      <div class="grid grid--cols-3">
                        <div class="item">
                          <div class="meta"></div>
                          <div class="content">
                            <span class="value value--small value--tnums">6.8 km</span>
                            <span class="label">Distance</span>
                          </div>
                        </div>
                        <div class="item">
                          <div class="meta"></div>
                          <div class="content">
                            <span class="value value--small value--tnums">24 min</span>
                            <span class="label">Ride</span>
                          </div>
                        </div>
                        <div class="item">
                          <div class="meta"></div>
                          <div class="content">
                            <span class="value value--small value--tnums">+41 m</span>
                            <span class="label">Climb</span>
                          </div>
                        </div>
                      </div>

                      <div id="map-commute" class="map stretch w--full"></div>
                    </div>

                    <div class="title_bar">
                      <img class="image image--adaptive" src="/images/plugins/trmnl--render.svg" alt="TRMNL Logo">
                      <span class="title">Map</span>
                      <span class="instance">Commute</span>
                    </div>
                  </div>

                  <script type="text/trmnl-example">
                    var route = [
                      [13.4240, 52.5390], [13.4205, 52.5352], [13.4150, 52.5310], [13.4088, 52.5265],
                      [13.4010, 52.5210], [13.3930, 52.5170], [13.3840, 52.5125], [13.3759, 52.5096]
                    ];

                    function whenReady(cb) {
                      var tries = 0;
                      (function attempt() {
                        if (window.TRMNLMaps && window.maplibregl) return cb();
                        if (++tries > 200) return;
                        setTimeout(attempt, 50);
                      })();
                    }

                    function point(coords, tag) {
                      return { type: "Feature", properties: { tag: tag }, geometry: { type: "Point", coordinates: coords } };
                    }

                    whenReady(function () {
                      var el = "map-commute";
                      TRMNLMaps.watch(el, function () {
                        var map = new maplibregl.Map(TRMNLMaps.options({ el: el, preset: "minimal" }));
                        map.on("load", function () {
                          map.addSource("route", { type: "geojson", data: { type: "Feature", geometry: { type: "LineString", coordinates: route } } });
                          map.addSource("ends", { type: "geojson", data: { type: "FeatureCollection", features: [point(route[0], "start"), point(route[route.length - 1], "end")] } });
                          // path()/marker() carry the paint; merge() adds your id, source and filter.
                          map.addLayer(TRMNLMaps.merge(TRMNLMaps.path(0, 1, { el: el, width: 3 }), { id: "route", source: "route" }));
                          map.addLayer(TRMNLMaps.merge(TRMNLMaps.marker(0, 1, { el: el, radius: 5 }), { id: "start", source: "ends", filter: ["==", ["get", "tag"], "start"] }));
                          map.addLayer(TRMNLMaps.merge(TRMNLMaps.marker(0, 1, { el: el, radius: 5, hollow: true }), { id: "end", source: "ends", filter: ["==", ["get", "tag"], "end"] }));
                        });
                        // fit() frames the route on an integer zoom, no animation.
                        TRMNLMaps.fit(map, route, { padding: TRMNLPaint.px(24, { el: el }), maxZoom: 14 });
                        return map;
                      });
                    });
                  </script>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(demo_code: 'var route = [
  [13.4240, 52.5390], [13.4205, 52.5352], [13.4150, 52.5310], [13.4088, 52.5265],
  [13.4010, 52.5210], [13.3930, 52.5170], [13.3840, 52.5125], [13.3759, 52.5096]
];

function point(coords, tag) {
  return { type: "Feature", properties: { tag: tag }, geometry: { type: "Point", coordinates: coords } };
}

whenReady(function () {
  var el = "map-commute";
  TRMNLMaps.watch(el, function () {
    var map = new maplibregl.Map(TRMNLMaps.options({ el: el, preset: "minimal" }));
    map.on("load", function () {
      map.addSource("route", { type: "geojson", data: { type: "Feature", geometry: { type: "LineString", coordinates: route } } });
      map.addSource("ends", { type: "geojson", data: { type: "FeatureCollection", features: [point(route[0], "start"), point(route[route.length - 1], "end")] } });
      // path()/marker() carry the paint; merge() adds your id, source and filter.
      map.addLayer(TRMNLMaps.merge(TRMNLMaps.path(0, 1, { el: el, width: 3 }), { id: "route", source: "route" }));
      map.addLayer(TRMNLMaps.merge(TRMNLMaps.marker(0, 1, { el: el, radius: 5 }), { id: "start", source: "ends", filter: ["==", ["get", "tag"], "start"] }));
      map.addLayer(TRMNLMaps.merge(TRMNLMaps.marker(0, 1, { el: el, radius: 5, hollow: true }), { id: "end", source: "ends", filter: ["==", ["get", "tag"], "end"] }));
    });
    // fit() frames the route on an integer zoom, no animation.
    TRMNLMaps.fit(map, route, { padding: TRMNLPaint.px(24, { el: el }), maxZoom: 14 });
    return map;
  });
});', language: 'javascript') %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Grayscale and color') %>
            <p class="<%= framework_subsection_description_classes %>">
              The map slots default to tokens tuned for 1-bit: land is the canvas, water, parks and fields are
              dithered tiles, roads are grays short of the ink, labels are the ink. A full-color screen re-points
              the same slots at chromatic tokens and a limited palette dithers them to its ink set, so the plugin
              changes nothing.
            </p>
            <p class="<%= framework_subsection_description_classes %>">
              Labels are framework elements placed over the canvas, so they take the screen's own fonts (TRMNL
              pixel fonts on 1-bit and 2-bit low-density panels, Inter on 4-bit and high density) with a large
              text stroke, on whole pixels.
            </p>
            <p class="<%= framework_subsection_description_classes %>">
              Switch the device picker to a color device or dark mode and the map repaints. A theme restyles the map
              with the same slot mixins it uses for every other component: see <%= render DocsRef.new(page: :theme_slots) %>.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <script data-trmnl-src="/framework-docs/maplibre-gl-5.24.0.js"></script>
                  <link data-trmnl-href="/framework-docs/maplibre-gl-5.24.0.css" rel="stylesheet">

                  <div class="view view--full">
                    <div class="layout layout--col gap--small">
                      <div id="map-color" class="map stretch w--full"></div>
                    </div>

                    <div class="title_bar">
                      <img class="image image--adaptive" src="/images/plugins/trmnl--render.svg" alt="TRMNL Logo">
                      <span class="title">Map</span>
                      <span class="instance">Sydney Harbour</span>
                    </div>
                  </div>

                  <script type="text/trmnl-example">
                    function whenReady(cb) {
                      var tries = 0;
                      (function attempt() {
                        if (window.TRMNLMaps && window.maplibregl) return cb();
                        if (++tries > 200) return;
                        setTimeout(attempt, 50);
                      })();
                    }

                    whenReady(function () {
                      var el = "map-color";
                      TRMNLMaps.watch(el, function () {
                        return new maplibregl.Map(TRMNLMaps.options({
                          el: el, preset: "streets", center: [151.2153, -33.8568], zoom: 12
                        }));
                      });
                    });
                  </script>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(demo_code: '// Nothing here names a device or a color: the slots resolve per screen.
TRMNLMaps.watch(el, function () {
  return new maplibregl.Map(TRMNLMaps.options({
    el: el, preset: "streets", center: [151.2153, -33.8568], zoom: 12
  }));
});

// A theme re-points a map slot like any other component slot (SCSS):
// @include theme-slots.bg-slot("map-water", "blue-65");
// @include theme-slots.bg-slot("map-road-minor", "gray-50");', language: 'javascript') %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Strava activity') %>
          <p class="<%= framework_section_description_classes %>">
            Strava returns each activity with <code class="<%= framework_section_code_classes %>">map.summary_polyline</code>,
            a Google encoded polyline. Decode it, fit the camera to it, draw the route with a start dot and an end ring,
            and show the activity stats in the framework layout.
          </p>
          <p class="<%= framework_section_description_classes %>">
            In a plugin the <code class="<%= framework_section_code_classes %>">activity</code> object comes from your
            polling URL; the example inlines one run. The roads are grays and the route takes the ink, so it reads
            on top; the minimal preset keeps the streets under it quiet.
          </p>
        </div>

        <div class="<%= framework_example_classes %>">
          <div class="<%= framework_example_inner_classes %>">
            <div class="<%= framework_example_wrapper_classes %>">
              <div class="screen">
