<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :paint_borders %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:paint_borders) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Borders and dividers') %>
          <p class="<%= framework_section_description_classes %>">
            Every function takes an optional <code class="<%= framework_section_code_classes %>">{ el }</code>: the id
            or element whose nearest <code class="<%= framework_section_code_classes %>">.screen</code>
            supplies the paint. How the reading works is on <%= render DocsRef.new(page: :paint_api) %>.
          </p>
          <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
            <li>
              <code class="<%= framework_section_code_classes %>">border(spec, { dir, el })</code>: one framework
              border line as a
              <code class="<%= framework_section_code_classes %>">BorderFill</code>. The
              <code class="<%= framework_section_code_classes %>">spec</code> is a shade step
              from 10 to 75, or
              <code class="<%= framework_section_code_classes %>">'black'</code> /
              <code class="<%= framework_section_code_classes %>">'white'</code>;
              <code class="<%= framework_section_code_classes %>">dir</code> is
              <code class="<%= framework_section_code_classes %>">'h'</code> (default) or
              <code class="<%= framework_section_code_classes %>">'v'</code>. Framework borders are painted as a
              background on a pseudo-element, so that is where the paint is read.
            </li>
            <li>
              <code class="<%= framework_section_code_classes %>">divider({ dir, el })</code>: the
              <code class="<%= framework_section_code_classes %>">.divider</code> line (level 6) as a
              <code class="<%= framework_section_code_classes %>">BorderFill</code>, read on the element itself.
            </li>
          </ul>
          <p class="<%= framework_section_description_classes %>">
            A dithered line is painted from several stacked layers, so
            <code class="<%= framework_section_code_classes %>">BorderFill</code> keeps
            <code class="<%= framework_section_code_classes %>">size</code>,
            <code class="<%= framework_section_code_classes %>">position</code>, and
            <code class="<%= framework_section_code_classes %>">repeat</code> as verbatim strings. It also
            carries the ready-made SVG drawing instructions the CSS declares, so JavaScript never parses gradients
            or works out geometry itself.
          </p>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(demo_code: 'BorderFill = {
  color:    string | null,  // resolved background-color (solid/black-white modes)
  image:    string | null,  // resolved background-image gradient(s); null when "none"
  url:      string | null,  // first url(...) ink tile (black/white lines); null otherwise
  size:     string | null,  // VERBATIM background-size string (dither lines are list-valued)
  position: string | null,  // VERBATIM background-position string
  repeat:   string | null,  // VERBATIM background-repeat string
  render: {                  // CSS-declared; copied verbatim by renderer adapters
    stroke:  string | null,
    width:   string | null,
    height:  string | null,
    viewBox: string | null,
    path1:   string | null,
    color1:  string | null,
    path2:   string | null,
    color2:  string | null,
  } | null,
  dir:      "h" | "v",      // which pseudo/orientation was read
}', language: 'javascript') %>
        </div>

        <div class="space-y-4 mt-4">
          <p class="<%= framework_section_description_classes %>">
            <code class="<%= framework_section_code_classes %>">border()</code> is the right call for drawing
            lines: it reads the <code class="<%= framework_section_code_classes %>">.border--*</code> utilities,
            which stay visible in every mode and follow themes for free.
            <code class="<%= framework_section_code_classes %>">semantic('border-strong')</code> and
            <code class="<%= framework_section_code_classes %>">semantic('border-muted')</code> return the role's
            color as a plain Fill, not the line artwork; reach for them only when you need the
            color itself.
          </p>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(demo_code: '// Framework border lines, read for the current mode/theme.
var gridLine = TRMNLPaint.border(65, { el: "my-chart" });     // -> BorderFill
var axisLine = TRMNLPaint.border("black", { dir: "v", el: "my-chart" });
var step40 = TRMNLPaint.border(40, { el: "my-chart" });', language: 'javascript') %>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Painting lines') %>
          <p class="<%= framework_section_description_classes %>">
            A BorderFill is written back verbatim, so it paints exactly as the CSS
            <code class="<%= framework_section_code_classes %>">.border--*</code> utilities do. Wrap the painting in
            <code class="<%= framework_section_code_classes %>">watch()</code> so lines re-read on mode, dark, and
            theme changes; see <%= render DocsRef.new(page: :paint_api) %>.
          </p>
          <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
            <li>
              <code class="<%= framework_section_code_classes %>">applyBorder(node, borderFill)</code>: writes a
              <code class="<%= framework_section_code_classes %>">BorderFill</code> onto a node as its five background
              properties; solids, gradients, and dithered lines all arrive unchanged.
            </li>
          </ul>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Highcharts axes') %>
          <p class="<%= framework_section_description_classes %>">
            The axis adapters copy a border line into Highcharts' native options; the fill adapter and the
            rules all adapters follow are on <%= render DocsRef.new(page: :paint_charts) %>.
          </p>
          <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
            <li>
              <code class="<%= framework_section_code_classes %>">toHighchartsAxis(borderFill)</code>: turns a
              <code class="<%= framework_section_code_classes %>">BorderFill</code> into a
              <code class="<%= framework_section_code_classes %>">{ gridLineColor, gridLineWidth, gridLineDashStyle, lineColor, tickColor }</code>
              block.
            </li>
            <li>
              <code class="<%= framework_section_code_classes %>">applyHighchartsAxisPaint()</code>: hooks into
              Highcharts' rendering and copies the BorderFill's SVG drawing instructions onto the
              rendered grid, axis, and tick paths. Flat modes carry a stroke; dither modes carry their complete
              pattern, paths and colors.
            </li>
          </ul>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(demo_code: '// Border lines into Highcharts axis/grid options.
var grid = TRMNLPaint.toHighchartsAxis(
  TRMNLPaint.border(65, { el: "my-chart" }));', language: 'javascript') %>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Live example') %>
          <p class="<%= framework_section_description_classes %>">
            The separator under each schedule row is painted with
            <code class="<%= framework_section_code_classes %>">TRMNLPaint.border()</code> and
            <code class="<%= framework_section_code_classes %>">TRMNLPaint.applyBorder()</code>, wrapped in
            <code class="<%= framework_section_code_classes %>">TRMNLPaint.watch()</code>. Each row uses a different
            spec (shade steps 65 and 40, then black and white), labelled on the right. Change the
            device mode or Style in the picker and the lines repaint, picking up dither patterns and theme colors.
          </p>
        </div>

        <div class="<%= framework_example_classes %>">
          <div class="<%= framework_example_inner_classes %>">
            <div class="<%= framework_example_wrapper_classes %>">
              <div class="screen">
                <div class="view view--full">
                  <div class="layout layout--col layout--center">
                    <div id="border-strip" class="flex flex--col w--full"></div>
                  </div>

                  <div class="title_bar">
                    <img class="image image--adaptive" src="/images/plugins/trmnl--render.svg" alt="TRMNL Logo">
                    <span class="title">Paint API</span>
                    <span class="instance">TRMNLPaint.applyBorder</span>
                  </div>
                </div>

                <script type="text/javascript">
                  function whenReady(cb) {
                    var tries = 0;
                    (function attempt() {
                      if (window.TRMNLPaint) return cb();
                      if (++tries > 200) return;
                      setTimeout(attempt, 50);
                    })();
                  }

                  whenReady(function () {
                    var el = "border-strip";
                    var ROWS = [
                      { time: "9:00",  what: "Conference room meeting",   spec: 65 },
                      { time: "11:30", what: "Diversity Day training",    spec: 40 },
                      { time: "14:00", what: "Dundies rehearsal",         spec: "black" },
                      { time: "16:00", what: "Party Planning Committee",  spec: "white" }
                    ];
                    // watch() re-reads each line whenever the screen device/scale/mode/dark/theme changes.
                    TRMNLPaint.watch(el, function () {
                      var box = document.getElementById(el);
                      if (!box) return;
                      box.innerHTML = "";
                      ROWS.forEach(function (r) {
                        var row = document.createElement("div");
                        row.className = "flex flex--row flex--center-y gap";
                        row.style.cssText = "padding:12px 0;";
                        var time = document.createElement("span");
                        time.className = "label label--small";
                        time.style.cssText = "width:56px;flex:none;";
                        time.textContent = r.time;
                        var what = document.createElement("span");
                        what.className = "title title--small";
                        what.style.cssText = "flex:1;";
                        what.textContent = r.what;
                        var cap = document.createElement("span");
                        cap.className = "label label--small";
                        cap.textContent = "border(" + JSON.stringify(r.spec) + ")";
                        row.appendChild(time);
                        row.appendChild(what);
                        row.appendChild(cap);
                        var line = document.createElement("div");
                        line.style.cssText = "height:2px;width:100%;";
                        // applyBorder paints the line exactly as the CSS .border--* utilities do.
                        TRMNLPaint.applyBorder(line, TRMNLPaint.border(r.spec, { el: el }));
                        box.appendChild(row);
                        box.appendChild(line);
                      });
                    });
                  });
                </script>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(demo_code: '<div id="border-strip" class="flex flex--col w--full"></div>

<script type="text/javascript">
  // plugins.js bundles TRMNLPaint; wait for it before painting.
  function whenReady(cb) {
    var tries = 0;
    (function attempt() {
      if (window.TRMNLPaint) return cb();
      if (++tries > 200) return;
      setTimeout(attempt, 50);
    })();
  }

  whenReady(function () {
    var el = "border-strip";
    var SPECS = [65, 40, "black", "white"];
    // watch() re-reads each line whenever the screen device/scale/mode/dark/theme changes.
    TRMNLPaint.watch(el, function () {
      var box = document.getElementById(el);
      if (!box) return;
      box.innerHTML = "";
      SPECS.forEach(function (spec) {
        var row = document.createElement("div");
        row.style.cssText = "padding:12px 0;";
        row.textContent = "border(" + JSON.stringify(spec) + ")";
        var line = document.createElement("div");
        line.style.cssText = "height:2px;width:100%;";
        // applyBorder paints the line exactly as the CSS .border--* utilities do.
        TRMNLPaint.applyBorder(line, TRMNLPaint.border(spec, { el: el }));
        box.appendChild(row);
        box.appendChild(line);
      });
    });
  });
</script>', language: 'html') %>
        </div>
      </section>
    </div>

    <%= render 'framework/page_navigation' %>
  </div>
</div>
