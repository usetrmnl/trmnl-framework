<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :flex %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:flex) %>

    <div class="space-y-16">
      <section class="space-y-8" id="when-to-use">
        <div class="space-y-4">
          <%= framework_heading(3, 'When to Use Flex') %>
          <p class="<%= framework_section_description_classes %>">
            Use Flex inside <%= render DocsRef.new(page: :layout) %> when you need flexible row or column arrangements. Flex lets items size by their content: width and height follow what's inside, rather than a fixed grid. It's the right choice when you want natural, content-driven layouts without strict column structure.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Content-Based Sizing') %>
            <p class="<%= framework_subsection_description_classes %>">
              Flex items grow and shrink based on their content by default. You can override this with stretch modifiers, grow/shrink utilities, or basis classes. Use Flex when your layout should adapt to the content rather than forcing content into a fixed grid: toolbars, inline groups of labels and values, or stacks of variable-height cards.
            </p>
          </div>

          <div class="space-y-2">
            <%= framework_heading(4, 'Standalone or Nested') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use Flex alone as the only child of Layout for simpler layouts. Nest it inside <%= render DocsRef.new(page: :grid) %> and each grid cell can hold its own Flex container for row or column flexibility within that cell. Nest it inside <%= render DocsRef.new(page: :columns) %> columns for per-column arrangement.
            </p>
          </div>

          <div class="space-y-2">
            <%= framework_heading(4, 'Compared to Grid and Columns') %>
            <p class="<%= framework_subsection_description_classes %>">
              Choose Flex when you need flexible, content-sized layouts. If you need strict column alignment and spans, use Grid. If you have lots of same-type data and want the system to handle column distribution and overflow, use <%= render DocsRef.new(page: :columns) %>.
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Base Structure') %>
          <p class="<%= framework_section_description_classes %>">
            Flex arranges content in one of two directions: horizontal (row) or vertical (column).
            These base structures can be combined with alignment and stretch modifiers for complex layouts.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Row Direction') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">flex flex--row</code> to create a horizontal layout:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap">
                      <div class="flex flex--row bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white h--12"><span class="label">Item 1</span></div>
                        <div class="p--4 rounded--medium bg--white h--12"><span class="label">Item 2</span></div>
                        <div class="p--4 rounded--medium bg--white h--12"><span class="label">Item 3</span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Row Direction</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--row">
  <div>Item 1</div>
  <div>Item 2</div>
  <div>Item 3</div>
</div>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Column Direction') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">flex flex--col</code> to create a vertical layout:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--row gap">
                      <div class="flex flex--col bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white h--12"><span class="label">Item 1</span></div>
                        <div class="p--4 rounded--medium bg--white h--12"><span class="label">Item 2</span></div>
                        <div class="p--4 rounded--medium bg--white h--12"><span class="label">Item 3</span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Column Direction</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--col">
  <div>Item 1</div>
  <div>Item 2</div>
  <div>Item 3</div>
</div>'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Alignment Modifiers') %>
          <p class="<%= framework_section_description_classes %>">
            Once you've chosen a base direction, you can apply alignment modifiers to control how items are positioned
            within their container. Modifiers cover directional alignment (left/right/top/bottom) and centering.
          </p>
          <p class="<%= framework_section_description_classes %>">
            <code class="<%= framework_section_code_classes %>">flex--start</code> and
            <code class="<%= framework_section_code_classes %>">flex--end</code> follow the container's direction: in a
            row they match <code class="<%= framework_section_code_classes %>">flex--left</code> and
            <code class="<%= framework_section_code_classes %>">flex--right</code>, in a column they match
            <code class="<%= framework_section_code_classes %>">flex--top</code> and
            <code class="<%= framework_section_code_classes %>">flex--bottom</code>. On a
            <code class="<%= framework_section_code_classes %>">flex</code> with no direction modifier they match
            <code class="<%= framework_section_code_classes %>">flex--left</code> and
            <code class="<%= framework_section_code_classes %>">flex--right</code>. Use them when a container flips
            direction responsively and the alignment should flip with it.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Row Horizontal Alignment') %>
            <p class="<%= framework_subsection_description_classes %>">
              For row layouts, use <code class="<%= framework_section_code_classes %>">flex--left</code>,
              <code class="<%= framework_section_code_classes %>">flex--center-x</code>, or
              <code class="<%= framework_section_code_classes %>">flex--right</code> to control horizontal alignment:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col layout--stretch gap">
                      <div class="flex flex--row flex--left bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label">Left</span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                      </div>
                      <div class="flex flex--row flex--center-x bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label">Center X</span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                      </div>
                      <div class="flex flex--row flex--right bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label">Right</span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Row Horizontal Alignment</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--row flex--left">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>

<div class="flex flex--row flex--center-x">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>

<div class="flex flex--row flex--right">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Row Vertical Alignment') %>
            <p class="<%= framework_subsection_description_classes %>">
              For row layouts, use <code class="<%= framework_section_code_classes %>">flex--top</code>,
              <code class="<%= framework_section_code_classes %>">flex--center-y</code>, or
              <code class="<%= framework_section_code_classes %>">flex--bottom</code> to control vertical alignment:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col layout--stretch gap">
                      <div class="flex flex--row flex--top bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label">Top</span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                      </div>
                      <div class="flex flex--row flex--center-y bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label">Center Y</span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                      </div>
                      <div class="flex flex--row flex--bottom bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label">Bottom</span></div>
                        <div class="p--4 rounded--medium bg--white text--center w--28 h--12"><span class="label"></span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Row Vertical Alignment</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--row flex--top">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>

<div class="flex flex--row flex--center-y">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>

<div class="flex flex--row flex--bottom">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Column Horizontal Alignment') %>
            <p class="<%= framework_subsection_description_classes %>">
              For column layouts, use <code class="<%= framework_section_code_classes %>">flex--left</code>,
              <code class="<%= framework_section_code_classes %>">flex--center-x</code>, or
              <code class="<%= framework_section_code_classes %>">flex--right</code> to control horizontal alignment:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--row layout--stretch gap">
                      <div class="flex flex--col flex--left bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"><span class="label text--center">Left</span></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                      </div>
                      <div class="flex flex--col flex--center-x bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"><span class="label text--center">Center X</span></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                      </div>
                      <div class="flex flex--col flex--right bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"><span class="label text--center">Right</span></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Column Horizontal Alignment</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--col flex--left">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>

<div class="flex flex--col flex--center-x">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>

<div class="flex flex--col flex--right">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Column Vertical Alignment') %>
            <p class="<%= framework_subsection_description_classes %>">
              For column layouts, use <code class="<%= framework_section_code_classes %>">flex--top</code>,
              <code class="<%= framework_section_code_classes %>">flex--center-y</code>, or
              <code class="<%= framework_section_code_classes %>">flex--bottom</code> to control vertical alignment:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--row layout--stretch gap">
                      <div class="flex flex--col flex--top bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white w--36 h--12"><span class="label text--center">Top</span></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                      </div>
                      <div class="flex flex--col flex--center-y bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"><span class="label text--center">Center Y</span></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                      </div>
                      <div class="flex flex--col flex--bottom bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge">
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"></div>
                        <div class="p--4 rounded--medium bg--white w--36 h--12"><span class="label text--center">Bottom</span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Column Vertical Alignment</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--col flex--top">
  <div>Item</div>
</div>

<div class="flex flex--col flex--center">
  <div>Item</div>
</div>

<div class="flex flex--col flex--bottom">
  <div>Item</div>
</div>'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Stretch Modifiers') %>
          <p class="<%= framework_section_description_classes %>">
            Stretch works at two levels: container modifiers affect all children, while item classes only affect the
            specific element they're applied to.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Container Stretch') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">flex--stretch</code>,
              <code class="<%= framework_section_code_classes %>">flex--stretch-x</code>, or
              <code class="<%= framework_section_code_classes %>">flex--stretch-y</code> to control how children fill the container:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap">
                      <div class="flex flex--row flex--stretch bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full h--36">
                        <div class="flex p--4 rounded--medium bg--white"><span class="label"></span></div>
                        <div class="flex p--4 rounded--medium bg--white flex--center"><span class="label">Stretch All</span></div>
                        <div class="flex p--4 rounded--medium bg--white"><span class="label"></span></div>
                      </div>
                      <div class="flex flex--row flex--stretch-x bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full h--36">
                        <div class="flex p--4 rounded--medium bg--white h--12"><span class="label"></span></div>
                        <div class="flex p--4 rounded--medium bg--white h--12 flex--center"><span class="label">Stretch X</span></div>
                        <div class="flex p--4 rounded--medium bg--white h--12"><span class="label"></span></div>
                      </div>
                      <div class="flex flex--row flex--stretch-y bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full h--36">
                        <div class="flex p--4 rounded--medium bg--white w--32"><span class="label"></span></div>
                        <div class="flex p--4 rounded--medium bg--white w--32 flex--center"><span class="label">Stretch Y</span></div>
                        <div class="flex p--4 rounded--medium bg--white w--32"><span class="label"></span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Container Stretch</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--row flex--stretch">
  <div>Item</div>
  <div>Item</div>
  <div>Item</div>
</div>

<div class="flex flex--row flex--stretch-x">
  <div>Item</div>
