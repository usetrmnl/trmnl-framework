            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Individual Item Stretch (Row)') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use <code class="<%= framework_section_code_classes %>">stretch</code>,
              <code class="<%= framework_section_code_classes %>">stretch-x</code>, or
              <code class="<%= framework_section_code_classes %>">stretch-y</code> on individual items in a row layout:
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap">
                      <div class="flex flex--row bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full h--36">
                        <div class="p--4 rounded--medium bg--white stretch"><span class="label">Stretch</span></div>
                        <div class="p--4 rounded--medium bg--white"><span class="label">Normal</span></div>
                        <div class="p--4 rounded--medium bg--white stretch"><span class="label">Stretch</span></div>
                      </div>
                      <div class="flex flex--row bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full h--36">
                        <div class="p--4 rounded--medium bg--white stretch-x"><span class="label">Stretch X</span></div>
                        <div class="p--4 rounded--medium bg--white"><span class="label">Normal</span></div>
                        <div class="p--4 rounded--medium bg--white stretch-x"><span class="label">Stretch X</span></div>
                      </div>
                      <div class="flex flex--row bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full h--36">
                        <div class="p--4 rounded--medium bg--white w--28 stretch-y"><span class="label">Stretch Y</span></div>
                        <div class="p--4 rounded--medium bg--white w--28 h--12"><span class="label">Normal</span></div>
                        <div class="p--4 rounded--medium bg--white w--28 stretch-y"><span class="label">Stretch Y</span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
