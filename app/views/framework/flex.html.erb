  <div class="self--start">self--start</div>
  <div class="self--center">self--center</div>
  <div class="self--end">self--end</div>
  <div class="self--stretch">self--stretch</div>
</div>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Grow/Shrink and Flex Shorthand') %>
            <p class="<%= framework_subsection_description_classes %>">
              Six utilities set an item's flex behavior. The demo below shows four of them.
            </p>
            <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
              <li><code class="<%= framework_section_code_classes %>">grow</code>: the item takes a share of the spare space.</li>
              <li><code class="<%= framework_section_code_classes %>">grow-0</code>: the item never takes a share, the explicit opposite of <code class="<%= framework_section_code_classes %>">grow</code>.</li>
              <li><code class="<%= framework_section_code_classes %>">shrink-0</code>: the item keeps its size when the container runs tight.</li>
              <li><code class="<%= framework_section_code_classes %>">flex-auto</code>: the item both grows and shrinks, starting from its content size.</li>
              <li><code class="<%= framework_section_code_classes %>">flex-initial</code>: the item shrinks but never grows.</li>
              <li><code class="<%= framework_section_code_classes %>">flex-none</code>: the item does neither and stays at its content size.</li>
            </ul>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap">
                      <div class="flex flex--row bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full">
                        <div class="p--4 rounded--medium bg--white grow"><span class="label">grow</span></div>
                        <div class="p--4 rounded--medium bg--white shrink-0 w--36"><span class="label">shrink-0</span></div>
                        <div class="p--4 rounded--medium bg--white flex-none w--36"><span class="label">flex-none</span></div>
                        <div class="p--4 rounded--medium bg--white flex-initial w--36"><span class="label">flex-initial</span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Grow/Shrink & Flex</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--row">
  <div class="grow">grow</div>
  <div class="shrink-0 w--36">shrink-0</div>
  <div class="flex-none w--36">flex-none</div>
  <div class="flex-initial w--36">flex-initial</div>
</div>'
            ) %>
          </div>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Basis and Order') %>
            <p class="<%= framework_subsection_description_classes %>">
              Basis sets the size an item starts from before it grows or shrinks. Order moves an item to a different
              position without changing the markup.
            </p>
            <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
              <li><code class="<%= framework_section_code_classes %>">basis--{size}</code>: the whole-number steps of the size scale, <code class="<%= framework_section_code_classes %>">basis--0</code> through <code class="<%= framework_section_code_classes %>">basis--96</code>. A step is 4px scaled by the content scale, so <code class="<%= framework_section_code_classes %>">basis--36</code> is 144px at scale 1. See <%= render DocsRef.new(page: :size) %>.</li>
              <li><code class="<%= framework_section_code_classes %>">basis--auto</code>: the item starts at its content size.</li>
              <li><code class="<%= framework_section_code_classes %>">order--{n}</code>: any whole number from -10 to 10. A negative number takes a third dash, so -1 is <code class="<%= framework_section_code_classes %>">order---1</code>.</li>
              <li><code class="<%= framework_section_code_classes %>">order--first</code> and <code class="<%= framework_section_code_classes %>">order--last</code>: move the item ahead of or behind every numbered item.</li>
            </ul>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap">
                      <div class="flex flex--row bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full">
                        <div class="p--4 rounded--medium bg--white basis--36"><span class="label">basis--36</span></div>
                        <div class="p--4 rounded--medium bg--white basis--20"><span class="label">basis--20</span></div>
                        <div class="p--4 rounded--medium bg--white basis--24"><span class="label">basis--24</span></div>
                      </div>
                      <div class="flex flex--row bg--gray-65 2bit:bg--gray-75 4bit:bg--gray-70 p--4 rounded--xlarge w--full">
                        <div class="p--4 rounded--medium bg--white order--last w--28"><span class="label">order--last</span></div>
                        <div class="p--4 rounded--medium bg--white order--first w--28"><span class="label">order--first</span></div>
                        <div class="p--4 rounded--medium bg--white order--2 w--28"><span class="label">order--2</span></div>
                        <div class="p--4 rounded--medium bg--white order---1 w--28"><span class="label">order---1</span></div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Basis & Order</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="flex flex--row">
  <div class="basis--36">basis--36</div>
  <div class="basis--20">basis--20</div>
  <div class="basis--24">basis--24</div>
</div>

<div class="flex flex--row">
  <div class="order--last">order--last</div>
  <div class="order--first">order--first</div>
  <div class="order--2">order--2</div>
  <div class="order---1">order---1</div>
</div>'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Inline Flex Containers') %>
          <p class="<%= framework_section_description_classes %>">
            Use <code class="<%= framework_section_code_classes %>">inline-flex</code> for inline-level flex containers that align alongside text.
          </p>
        </div>

        <div class="space-y-6">
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap">
                      <div class="bg--white p--4 rounded--xlarge">
                        <span class="label">Text before</span>
                        <div class="inline-flex flex--row gap">
                          <div class="p--2 rounded--medium bg--gray-65 w--20 h--12"></div>
                          <div class="p--2 rounded--medium bg--gray-65 w--20 h--12"></div>
                        </div>
                        <span class="label">Text after</span>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Flex</span>
                      <span class="instance">Inline Flex</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<span class="label">Text before</span>
<div class="inline-flex flex--row gap">
  <div>•</div>
  <div>•</div>
</div>
<span class="label">Text after</span>'
            ) %>
          </div>
        </div>
      </section>

      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
