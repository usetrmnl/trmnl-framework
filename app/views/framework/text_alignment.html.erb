<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :text_alignment %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:text_alignment) %>

    <div class="space-y-16">

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Usage') %>
          <p class="<%= framework_section_description_classes %>">
            Control text alignment using the alignment utility classes. Options include left, center, right, and justify alignment.
            See the <%= link_to 'Responsive Features', '#responsive-text-alignment', class: 'hover:underline' %> section for breakpoint, orientation, and bit-depth variants.
          </p>
        </div>

        <div class="<%= framework_docs_table_wrapper_classes %>">
          <div class="<%= framework_docs_table_card_classes %>">
            <table class="<%= framework_docs_table_classes %>">
              <thead>
                <tr>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Class</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Description</th>
                </tr>
              </thead>
              <tbody class="<%= framework_docs_table_body_classes %>">
                <% [
                  ['text--left',    'Aligns text to the left (default for most elements)'],
                  ['text--center',  'Centers text horizontally'],
                  ['text--right',   'Aligns text to the right'],
                  ['text--justify', 'Justifies text, creating even edges on both sides']
                ].each do |class_name, description| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                      <code class="text-sm font-mono text-syntax-string"><%= class_name %></code>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= description %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="space-y-6">
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap">
                      <div class="w--64 p-4 border border-2 border-dashed rounded-lg">
                        <p class="description mb--6 text--left">This text is left-aligned. This is the default alignment for most text content.</p>
                        <p class="description mb--6 text--center">This text is center-aligned. Useful for headings and important content.</p>
                        <p class="description mb--6 text--right">This text is right-aligned. Often used for numerical data or RTL languages.</p>
                        <p class="description text--justify">This text is justified. Creates even text edges on both sides but affects readability. Useful for multi-column text layouts.</p>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Text</span>
                      <span class="instance">Alignment</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<p class="text--left">Left-aligned text</p>
<p class="text--center">Center-aligned text</p>
<p class="text--right">Right-aligned text</p>
<p class="text--justify">Justified text</p>'
            ) %>
          </div>
        </div>
      </section>

      <section id="responsive-text-alignment" class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Responsive Features') %>
          <p class="<%= framework_section_description_classes %>">
            Alignment classes support all three responsive systems: size-based breakpoints, orientation-based, and bit-depth variants.
          </p>
        </div>

        <div class="space-y-8">
          <div class="space-y-6">
            <div class="space-y-2">
              <%= framework_heading(4, 'Breakpoint Prefixes') %>
              <p class="<%= framework_subsection_description_classes %>">
                Use breakpoint prefixes like <code class="<%= framework_section_code_classes %>">sm:</code>,
                <code class="<%= framework_section_code_classes %>">md:</code>, <code class="<%= framework_section_code_classes %>">lg:</code>
                to apply different alignment per device size class.
              </p>
            </div>

            <div class="<%= framework_example_classes %>">
              <div class="<%= framework_example_inner_classes %>">
                <div class="<%= framework_example_wrapper_classes %>">
                  <div class="screen">
                    <div class="view view--full">
                      <div class="layout layout--col gap">
                        <div class="flex flex--col">
                          <p class="description text--left md:text--center lg:text--right">Responsive alignment</p>
                          <p class="label label--small">Left by default, center on md+, right on lg+</p>
                        </div>
                      </div>
                      <div class="title_bar">
                        <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                        <span class="title">Text Alignment</span>
                        <span class="instance">Responsive</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <%= render CodeExampleComponent.new(
                demo_code: '<!-- Left by default, center on md+, right on lg+ -->
<p class="description text--left md:text--center lg:text--right">Responsive alignment</p>

<!-- Progressive alignment scaling -->
<p class="description text--left sm:text--center md:text--right lg:text--justify">Progressive alignment</p>'
              ) %>
            </div>
          </div>

          <div class="space-y-6">
            <div class="space-y-2">
              <%= framework_heading(4, 'Orientation and Size+Orientation') %>
              <p class="<%= framework_subsection_description_classes %>">
                Text alignment can adapt to orientation with <code class="<%= framework_section_code_classes %>">portrait:</code> and <code class="<%= framework_section_code_classes %>">landscape:</code>, and can be combined
                with size breakpoints (e.g., <code class="<%= framework_section_code_classes %>">md:portrait:</code>).
              </p>
            </div>

            <div class="<%= framework_example_classes %>">
              <div class="<%= framework_example_inner_classes %>">
                <div class="<%= framework_example_wrapper_classes %>">
                  <div class="screen">
                    <div class="view view--full">
                      <div class="layout layout--col gap">
                        <div class="flex flex--col">
                          <p class="description text--left portrait:text--center">Orientation variant</p>
                          <p class="label label--small">Left by default, center in portrait</p>
                        </div>
                      </div>
                      <div class="title_bar">
                        <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                        <span class="title">Text Alignment</span>
                        <span class="instance">Orientation</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <%= render CodeExampleComponent.new(
                demo_code: '<!-- Left by default, center in portrait -->
<p class="description text--left portrait:text--center">Orientation variant</p>

<!-- Combined size and orientation -->
<p class="description text--left md:portrait:text--right">Left by default, right on md+ portrait</p>'
              ) %>
            </div>
          </div>

          <div class="space-y-6">
            <div class="space-y-2">
              <%= framework_heading(4, 'Bit-Depth Responsive') %>
              <p class="<%= framework_subsection_description_classes %>">
                Alignment classes support bit-depth prefixes like <code class="<%= framework_section_code_classes %>">1bit:</code>,
                <code class="<%= framework_section_code_classes %>">2bit:</code>, and <code class="<%= framework_section_code_classes %>">4bit:</code> to apply different alignment on different display color capabilities.
              </p>
            </div>

            <div class="<%= framework_example_classes %>">
              <div class="<%= framework_example_inner_classes %>">
                <div class="<%= framework_example_wrapper_classes %>">
                  <div class="screen">
                    <div class="view view--full">
                      <div class="layout layout--col gap">
                        <div class="flex flex--col">
                          <p class="description text--center 2bit:text--right">Bit-depth alignment</p>
                          <p class="label label--small">Center by default, right on 2-bit screens</p>
                        </div>
                      </div>
                      <div class="title_bar">
                        <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                        <span class="title">Text Alignment</span>
                        <span class="instance">Bit-Depth Responsive</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <%= render CodeExampleComponent.new(
                demo_code: '<!-- Center by default, right on 2-bit screens -->
<p class="description text--center 2bit:text--right">Bit-depth alignment</p>

<!-- Combined: size + bit-depth -->
<p class="description text--left lg:4bit:text--center">Left by default, center on lg+ 4-bit screens</p>'
              ) %>
            </div>
          </div>

          <div class="space-y-6">
            <div class="space-y-2">
              <%= framework_heading(4, 'Combined Responsive Features') %>
              <p class="<%= framework_subsection_description_classes %>">
                Combine size, orientation, and bit-depth modifiers for alignment. Use the pattern
                <code class="<%= framework_section_code_classes %>">size:orientation:bit-depth:utility</code> for highly targeted styling.
              </p>
            </div>

            <div class="mt-4">
              <%= render CodeExampleComponent.new(
                demo_code: '<!-- Size + orientation + bit-depth -->
<p class="description md:portrait:2bit:text--right">Right on md+ portrait 2-bit screens</p>

<!-- Multiple responsive conditions -->
<p class="description text--left sm:text--center lg:4bit:text--right">Progressive with bit-depth override</p>'
              ) %>
            </div>
          </div>
        </div>
      </section>

      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
