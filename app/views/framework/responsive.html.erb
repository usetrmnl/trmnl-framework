                  <th class="<%= framework_docs_table_header_cell_classes %>">Component</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Size</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Orientation</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Bit-Depth</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Example Usage</th>
                </tr>
              </thead>
