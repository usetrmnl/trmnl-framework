<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :responsive %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:responsive) %>

    <div class="space-y-16">
      <!-- Component Support -->
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(2, 'Component Support') %>
          <p class="<%= framework_section_description_classes %>">
            Not all framework components support responsive variants. We're trying to keep the framework as minimal as we can while offering the features you need.
          </p>
        </div>

        <div class="space-y-8">
          <!-- Component Support Table -->
          <div class="space-y-4">
            <p class="<%= framework_section_description_classes %>">
              This table shows which responsive features each framework component supports. Use this reference to understand what's possible with each component type.
            </p>
          </div>

