      <!-- Size-Based Responsive Section -->
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(2, 'Size-Based Responsive') %>
        </div>

        <div class="space-y-8">
          <div class="space-y-4">
            <%= framework_heading(3, 'How It Works') %>
            <p class="<%= framework_section_description_classes %>">
              Every device carries a size class (e.g., <code class="<%= framework_section_code_classes %>">screen--md</code>) that activates the matching responsive utilities.
              The class comes from the device model, not from a measured width, so pick a breakpoint by the devices you want to hit rather than by a pixel count.
            </p>
            <div class="<%= message_sage_classes %>">
              <div class="flex items-center w-full">
                <div class="flex-shrink-0 items-center">
                  <%= render 'shared/icons/info' %>
                </div>
                <div class="w-full flex items-center justify-between ml-3">
                  <p class="text-sm font-medium">
                    The system follows a mobile-first approach. When you use <code class="font-mono">md:value--large</code>, it applies on medium screens and larger.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Basic Usage -->
          <div class="space-y-6">
            <div class="space-y-2">
              <%= framework_heading(3, 'Basic Usage') %>
              <p class="<%= framework_subsection_description_classes %>">
