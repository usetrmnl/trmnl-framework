            </p>
          </div>

          <div class="<%= framework_docs_table_wrapper_classes %>">
            <div class="<%= framework_docs_table_card_classes %>">
              <table class="<%= framework_docs_table_classes %>">
              <thead>
                <tr>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Prefix</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Screen Class</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Color Support</th>
