<%# The docs command palette: every page of the section, server-rendered into its list. %>
<% titles = page_titles %>
<% section_name = current_section.to_s.humanize %>

<div data-controller="command-palette"
     class="hidden fixed inset-0 z-[200]"
     aria-hidden="true"
     data-action="click->command-palette#onOutsideClick">

  <div class="absolute inset-0 bg-gray-100/40 dark:bg-gray-850/40 backdrop-blur-[2px] transition-opacity"
       data-command-palette-target="backdrop"></div>

  <div class="relative z-10 flex min-h-full items-start justify-center p-4 sm:p-6 md:p-20"
       data-command-palette-target="frame">
    <div class="flex min-h-0 w-full max-w-3xl flex-col divide-y divide-gray-100 overflow-hidden rounded-xl bg-gray-25 shadow-xl outline outline-1 outline-black/5 dark:divide-gray-700 dark:bg-gray-850 dark:-outline-offset-1 dark:outline-gray-700"
         data-command-palette-target="panel"
         role="dialog"
         aria-modal="true"
         aria-label="Command Palette">
      <div class="grid grid-cols-1">
        <%= render 'shared/icons/search', classes: 'pointer-events-none col-start-1 row-start-1 ml-4 w-5 h-5 self-center text-gray-400 dark:text-gray-500' %>
        <div class="col-start-1 row-start-1 h-16 w-full pr-4 pl-11 flex items-center gap-2"
             data-action="pointerdown->command-palette#focusSearchChrome">
          <div role="searchbox"
               aria-label="Search"
               contenteditable="plaintext-only"
               spellcheck="false"
               data-placeholder="Search..."
               class="flex-auto min-h-6 w-px min-w-0 cursor-text overflow-hidden whitespace-nowrap text-base leading-6 text-gray-900 sm:text-sm sm:leading-5 bg-transparent dark:bg-transparent dark:text-white border-0 focus:border-0 outline-none focus:outline-none focus-visible:outline-none ring-0 focus:ring-0 focus-visible:ring-0 focus:shadow-none"
               style="outline: none; box-shadow: none; border: 0; --tw-ring-color: transparent; --tw-ring-shadow: 0 0 #0000; --tw-ring-offset-shadow: 0 0 #0000;"
               data-command-palette-target="input"
               data-action="input->command-palette#onInput keydown->command-palette#onInputKeydown"></div>
          <button type="button"
                  class="hidden flex-none rounded-full p-2 text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300"
                  aria-label="Close command palette"
                  data-command-palette-target="closeButton"
                  data-action="click->command-palette#close">
            <%= render 'shared/icons/x' %>
          </button>
        </div>
      </div>

      <div class="flex min-h-0 flex-1 flex-col divide-y divide-gray-100 dark:divide-white/10 md:flex-none">
        <div class="flex min-h-0 flex-1 md:flex-none">
          <div class="min-h-0 min-w-0 flex-auto scroll-py-4 overflow-y-auto p-4 md:max-h-96 [ &>div[role='option'] ]:border-b [ &>div[role='option'] ]:border-gray-100 dark:[ &>div[role='option'] ]:border-white/10"
               data-command-palette-target="list"
               role="listbox">
            <%# The three fixed targets come first: filtering rebuilds the list around them. %>
            <h3 class="mb-2 mt-3 text-xs font-semibold text-gray-900 dark:text-white hidden"
                data-command-palette-target="topHeader">Top Result</h3>
            <div data-command-palette-target="topResultContainer"></div>
            <div class="px-4 py-12 text-center text-sm text-gray-500 dark:text-gray-400 hidden"
                 data-command-palette-target="empty">
              No results found
            </div>

            <% framework_nav_groups.each do |group_key, page_keys| %>
              <% group_name = "#{section_name} - #{group_key.to_s.humanize}" %>
              <h3 class="mb-2 mt-3 text-xs font-medium text-gray-600 dark:text-gray-400"
                  data-command-palette-target="sectionHeader"
                  data-group="<%= group_name %>"><%= group_name %></h3>
              <% page_keys.each do |page_key| %>
                <% title = titles[page_key] || page_key.to_s.titleize %>
                <% description = page_description(page_key) %>
                <% href = framework_page_path(page_key) %>
                <div class="group flex cursor-default items-center rounded-2xl p-2 select-none text-gray-700 dark:text-gray-300 aria-selected:bg-sage-75/80 dark:aria-selected:bg-sage-850 aria-selected:ring-1 aria-selected:ring-sage-100 dark:aria-selected:ring-sage-800 aria-selected:text-sage-700 dark:aria-selected:text-sage-400"
                     role="option"
                     aria-selected="false"
                     data-command-palette-target="item"
                     data-action="mouseenter->command-palette#onItemMouseEnter click->command-palette#onItemClick"
                     data-key="<%= page_key %>"
                     data-title="<%= title %>"
                     data-description="<%= description %>"
                     data-group="<%= group_name %>"
                     data-href="<%= href %>">
                  <a class="flex items-center gap-3 no-underline focus:outline-none w-full" href="<%= href %>">
                    <span class="js-cmdp-icon flex-none text-gray-500 dark:text-gray-600 w-10 h-10 [&>svg]:w-full [&>svg]:h-full group-aria-selected:text-sage-500 dark:group-aria-selected:text-sage-500"><%= page_icon(page_key, 'w-6 h-6') %></span>
                    <span class="flex-auto truncate">
                      <span class="block truncate font-medium text-gray-900 dark:text-gray-550 group-aria-selected:text-sage-700 dark:group-aria-selected:text-sage-100"><%= title %></span>
                      <% if description.present? %>
                        <span class="block truncate text-xs text-gray-400 dark:text-gray-600 dark:group-aria-selected:text-sage-400"><%= description %></span>
                      <% end %>
                    </span>
                    <span class="ml-3 hidden group-aria-selected:inline text-sm leading-tight text-sage-400 dark:text-sage-500 whitespace-nowrap"
                          data-command-palette-action-hint>
                      <kbd class="mx-1 flex h-5 px-2 items-center justify-center rounded-xl bg-white px-1 text-sage-600 dark:bg-gray-800 dark:text-sage-400 inline-flex text-xs">enter</kbd>
                    </span>
                  </a>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="flex items-center justify-between bg-gray-50 px-4 py-2.5 text-xs text-gray-700 dark:bg-gray-800 dark:text-gray-300"
             data-command-palette-target="keyboardHints">
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-gray-500 dark:text-gray-600">Press</span>

            <div class="flex items-center">
              <kbd class="mx-1 flex h-5 items-center justify-center rounded-xl bg-white px-2 text-gray-900 dark:bg-gray-850 dark:text-gray-400 inline-flex">⌘K</kbd>
              <span class="text-gray-700 dark:text-gray-500">to toggle</span>
            </div>

            <div class="flex items-center">
              <kbd class="mx-1 flex h-5 items-center justify-center rounded-xl bg-white px-2 text-gray-900 dark:bg-gray-850 dark:text-gray-400 inline-flex min-w-[1.25rem]">↓↑</kbd>
              <span class="text-gray-700 dark:text-gray-500">to browse</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
