<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :background %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:background) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Grayscale') %>
          <p class="<%= framework_section_description_classes %>">
            Grayscale background shades only, including the center spacer between 40 and 45.
          </p>
        </div>

        <div class="<%= framework_example_classes %>">
          <div class="<%= framework_example_inner_classes %>">
            <div class="<%= framework_example_wrapper_classes %>">
              <div class="screen">
                <div class="view view--full">
                  <% grayscale_tokens = %w[black gray-10 gray-15 gray-20 gray-25 gray-30 gray-35 gray-40 gray-45 gray-50 gray-55 gray-60 gray-65 gray-70 gray-75 white] %>
                  <% grayscale_labels = ['black', '10', '15', '20', '25', '30', '35', '40', '45', '50', '55', '60', '65', '70', '75', 'white'] %>
                  <div class="layout layout--col gap py--4">
                    <div class="flex flex--row flex--wrap gap--xsmall">
                      <% grayscale_labels.each do |label_text| %>
                        <div class="w--7 portrait:w--6 lg:w--12 flex flex--center-x">
                          <span class="label label--small text--center"><%= label_text %></span>
                        </div>
                      <% end %>
                    </div>
                    <div class="flex flex--row flex--wrap gap--xsmall h--full">
                      <% grayscale_tokens.each do |token| %>
                        <% if token == 'white' %>
                          <div class="w--7 portrait:w--6 lg:w--12 h--full rounded bg--white outline"></div>
                        <% else %>
                          <div class="w--7 portrait:w--6 lg:w--12 h--full rounded bg--<%= token %>"></div>
                        <% end %>
                      <% end %>
                    </div>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                    <span class="title">Grayscale backgrounds</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="dark-mode-notice hidden <%= message_sage_classes %>">
          <div class="flex items-center w-full">
            <div class="flex-shrink-0 items-center">
              <%= render 'shared/icons/info' %>
            </div>
            <div class="w-full flex items-center justify-between ml-3">
              <p class="text-sm font-medium">
                <strong>Dark Mode Notice:</strong> The color palette appears inverted because dark mode remaps the framework tokens: black and white swap, grays and chromatic steps mirror. Images are not affected unless they opt in via <code class="<%= framework_section_code_classes %>">image--adaptive</code>. Themed screens are exempt from dark mode entirely.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Base Colors') %>
          <p class="<%= framework_section_description_classes %>">
            Full base palettes for background tokens: grayscale and all chromatic hues with every shade step.
          </p>
        </div>

        <div class="<%= framework_example_classes %>">
          <div class="<%= framework_example_inner_classes %>">
            <div class="<%= framework_example_wrapper_classes %>">
              <div class="screen">
                <div class="view view--full">
                  <% grayscale_tokens_before = %w[gray-10 gray-15 gray-20 gray-25 gray-30 gray-35 gray-40] %>
                  <% grayscale_tokens_after = %w[gray-45 gray-50 gray-55 gray-60 gray-65 gray-70 gray-75] %>
                  <% chromatic_hues = %w[red orange yellow lime green cyan blue violet purple pink] %>
                  <% chromatic_steps_before = [10, 15, 20, 25, 30, 35, 40] %>
                  <% chromatic_steps_after = [45, 50, 55, 60, 65, 70, 75] %>
                  <% base_colors_labels = ['10', '15', '20', '25', '30', '35', '40', 'base', '45', '50', '55', '60', '65', '70', '75'] %>
                  <div class="layout layout--col gap py--4">
                    <div class="flex flex--col gap--xsmall">
                      <div class="flex flex--row flex--wrap gap--xsmall">
                        <% base_colors_labels.each do |label_text| %>
                          <div class="w--7 portrait:w--6 lg:w--12 flex flex--center-x">
                            <span class="label label--small text--center"><%= label_text %></span>
                          </div>
                        <% end %>
                      </div>
                      <div class="flex flex--row flex--wrap gap--xsmall">
                        <% grayscale_tokens_before.each do |token| %>
                          <div class="w--7 portrait:w--6 lg:w--12 h--full rounded bg--<%= token %>"></div>
                        <% end %>
                        <div class="w--7 portrait:w--6 lg:w--12 h--full rounded"></div>
                        <% grayscale_tokens_after.each do |token| %>
                          <div class="w--7 portrait:w--6 lg:w--12 h--full rounded bg--<%= token %>"></div>
                        <% end %>
                      </div>
                    </div>

                    <% chromatic_hues.each do |hue| %>
                      <div class="flex flex--col gap--xsmall">
                        <div class="flex flex--row flex--wrap gap--xsmall">
                          <% chromatic_steps_before.each do |step| %>
                            <div class="w--7 portrait:w--6 lg:w--12 aspect--1/1 rounded bg--<%= hue %>-<%= step %>"></div>
                          <% end %>
                          <div class="w--7 portrait:w--6 lg:w--12 aspect--1/1 rounded bg--<%= hue %>"></div>
                          <% chromatic_steps_after.each do |step| %>
                            <div class="w--7 portrait:w--6 lg:w--12 aspect--1/1 rounded bg--<%= hue %>-<%= step %>"></div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>

                  <div class="title_bar">
                    <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                    <span class="title">Base background colors</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Usage') %>
          <p class="<%= framework_section_description_classes %>">
            Use the <code class="<%= framework_section_code_classes %>">bg--{shade}</code> utility classes to apply
            these background patterns to any element. The shade comes from one of three schemes
            (see <%= link_to 'Colors', framework_docs_colors_path, class: 'font-medium hover:underline' %>):
          </p>
          <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
            <li>
              <strong>Grayscale:</strong> <code class="<%= framework_section_code_classes %>">bg--black</code>,
              <code class="<%= framework_section_code_classes %>">bg--gray-10</code> through
              <code class="<%= framework_section_code_classes %>">bg--gray-75</code>, and
              <code class="<%= framework_section_code_classes %>">bg--white</code>.
            </li>
            <li>
              <strong>Chromatic:</strong> <code class="<%= framework_section_code_classes %>">bg--{hue}</code> for the
              pure color (e.g. bg--red, bg--green), or
              <code class="<%= framework_section_code_classes %>">bg--{hue}-{step}</code> for a step on that hue's
              ladder (e.g. bg--red-50, bg--blue-40).
            </li>
            <li>
              <strong>Semantic:</strong> <code class="<%= framework_section_code_classes %>">bg--primary</code>,
              <code class="<%= framework_section_code_classes %>">bg--success</code>,
              <code class="<%= framework_section_code_classes %>">bg--error</code>, and
              <code class="<%= framework_section_code_classes %>">bg--warning</code>.
            </li>
            <li>
              <strong>Surface roles:</strong> <code class="<%= framework_section_code_classes %>">bg--canvas</code>,
              <code class="<%= framework_section_code_classes %>">bg--surface</code>, and
              <code class="<%= framework_section_code_classes %>">bg--backdrop</code> paint the screen's own
              background roles.
            </li>
          </ul>
          <p class="<%= framework_section_description_classes %>">
            The surface roles resolve through the theme slot chain, so a theme repaints them. Reach for them when a
            block should follow the screen instead of pinning a shade a theme cannot move. See
            <%= render DocsRef.new(page: :theme_slots) %>.
          </p>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(
            demo_code: '<div class="bg--black">Black</div>
<div class="bg--gray-10">Gray 10</div>
<div class="bg--gray-15">Gray 15</div>
<div class="bg--gray-20">Gray 20</div>
<div class="bg--gray-25">Gray 25</div>
<div class="bg--gray-30">Gray 30</div>
<div class="bg--gray-35">Gray 35</div>
<div class="bg--gray-40">Gray 40</div>
<div class="bg--gray-45">Gray 45</div>
<div class="bg--gray-50">Gray 50</div>
<div class="bg--gray-55">Gray 55</div>
<div class="bg--gray-60">Gray 60</div>
<div class="bg--gray-65">Gray 65</div>
<div class="bg--gray-70">Gray 70</div>
<div class="bg--gray-75">Gray 75</div>
<div class="bg--white">White</div>'
          ) %>
        </div>

        <div class="<%= framework_section_description_classes %>">
          <strong>Device Preview tip:</strong> Use the Device Preview (top right) to switch between grayscale and color palettes. Try Inky Impression 7.3 (color-7a) or Tidbyt (color-24bit) to see chromatic colors.
        </div>

        <div class="mt-8">
          <%= framework_heading(4, 'Chromatic tokens') %>
          <p class="<%= framework_section_description_classes %> mb-4">
            Use <code class="<%= framework_section_code_classes %>">bg--{hue}-{step}</code> and <code class="<%= framework_section_code_classes %>">text--{hue}-{step}</code> for color backgrounds and text.
          </p>
          <%= render CodeExampleComponent.new(
            demo_code: '<div class="bg--red">Pure red</div>
<div class="bg--red-50">Red 50</div>
<div class="bg--blue-40">Blue 40</div>
<div class="bg--green-60">Green 60</div>
<div class="text--red-50">Red text</div>'
          ) %>
        </div>

        <div class="mt-8">
          <%= framework_heading(4, 'Semantic tokens') %>
          <p class="<%= framework_section_description_classes %> mb-4">
            Use <code class="<%= framework_section_code_classes %>">bg--{role}</code> and <code class="<%= framework_section_code_classes %>">text--{role}</code> for intent-based colors. Roles: primary, success, error, warning. See <%= link_to 'Colors', framework_docs_colors_path, class: 'font-medium hover:underline' %> for the full mapping.
          </p>
          <%= render CodeExampleComponent.new(
            demo_code: '<div class="bg--primary text--white">Primary</div>
<div class="bg--success text--white">Success</div>
<div class="bg--error text--white">Error</div>
<div class="text--warning">Warning text</div>'
          ) %>
        </div>
      </section>
      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
