<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :border %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:border) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Usage') %>
          <p class="<%= framework_section_description_classes %>">
            Use <code class="<%= framework_section_code_classes %>">border--h-{step}</code> and
            <code class="<%= framework_section_code_classes %>">border--v-{step}</code>
            with steps 10 to 75, the same shade scale as backgrounds, plus
            <code class="<%= framework_section_code_classes %>">border--h-black</code> and
            <code class="<%= framework_section_code_classes %>">border--h-white</code>.
            Borders render grayscale by default; a theme recolors all of them.
          </p>
          <p class="<%= framework_section_description_classes %>">
            4-bit and full-color screens give each of the 14 steps its own shade. Everywhere else (1-bit, 2-bit,
            the limited palettes, and screens with no mode class) two neighboring steps share a line, so
            <code class="<%= framework_section_code_classes %>">border--h-40</code> and
            <code class="<%= framework_section_code_classes %>">border--h-45</code> draw the same line.
          </p>
          <p class="<%= framework_section_description_classes %>">
            Pick steps 10 apart, like 40 and 50, when two lines have to read differently on a 1-bit panel.
          </p>
          <p class="<%= framework_section_description_classes %>">
            The numbered level classes (<code class="<%= framework_section_code_classes %>">border--h-1</code> through
            <code class="<%= framework_section_code_classes %>">border--h-7</code>, and their vertical counterparts) are
            deprecated and will be removed in Framework 4.0. Use the step classes in new markup.
          </p>
        </div>

        <div class="space-y-8">
          <div class="space-y-4">
            <%= framework_heading(4, 'Horizontal Borders') %>
            <div class="<%= framework_example_classes %>">
              <div class="<%= framework_example_inner_classes %>">
                <div class="<%= framework_example_wrapper_classes %>">
                  <div class="screen">
                    <div class="view view--full">
                      <div class="layout">
                        <div class="flex flex--row gap w--full h--full flex--stretch">
                          <% all_steps = [10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70, 75] %>
                          <!-- White Background -->
                          <div class="flex flex--col gap--space-between p--4 rounded bg--white">
                            <% all_steps.each do |step| %>
                              <div class="item border--h-<%= step %>">
                                <span class="label mb--2"><%= step %></span>
                              </div>
                            <% end %>
                          </div>
                          <!-- Black Background -->
                          <div class="flex flex--col gap--space-between p--4 rounded bg--black">
                            <% all_steps.each do |step| %>
                              <div class="item border--h-<%= step %>">
                                <span class="label mb--2 text--white"><%= step %></span>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                      <div class="title_bar">
                        <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                        <span class="title">Horizontal Borders</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="dark-mode-notice hidden <%= message_sage_classes %> !mt-0">
              <div class="flex items-center w-full">
                <div class="flex-shrink-0 items-center">
                  <%= render 'shared/icons/info' %>
                </div>
                <div class="w-full flex items-center justify-between ml-3">
                  <p class="text-sm font-medium">
                    <strong>Dark Mode Notice:</strong> The palette appears inverted because dark mode swaps black and white and mirrors the gray and color ladders. Images are not affected unless they opt in via <code class="<%= framework_section_code_classes %>">image--adaptive</code>. Themed screens ignore dark mode entirely.
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <%= render CodeExampleComponent.new(
                demo_code: '<div class="border--h-10">Dark border</div>
<div class="border--h-45">Mid border</div>
<div class="border--h-75">Light border</div>'
              ) %>
            </div>
          </div>

          <div class="space-y-4">
            <%= framework_heading(4, 'Vertical Borders') %>
            <div class="<%= framework_example_classes %>">
              <div class="<%= framework_example_inner_classes %>">
                <div class="<%= framework_example_wrapper_classes %>">
                  <div class="screen">
                    <div class="view view--full">
                      <div class="layout">
                        <div class="flex flex--col flex--stretch gap w--full h--full">
                          <% all_steps = [10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70, 75] %>
                          <!-- White Background -->
                          <div class="flex flex--row flex--stretch p--4 rounded bg--white">
                            <% all_steps.each do |step| %>
                              <div class="stretch border--v-<%= step %> flex flex--col flex--bottom">
                                <span class="label ml--2"><%= step %></span>
                              </div>
                            <% end %>
                          </div>
                          <!-- Black Background -->
                          <div class="flex flex--row flex--stretch p--4 rounded bg--black">
                            <% all_steps.each do |step| %>
                              <div class="stretch border--v-<%= step %> flex flex--col flex--bottom">
                                <span class="label ml--2 text--white"><%= step %></span>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                      <div class="title_bar">
                        <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                        <span class="title">Vertical Borders</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <%= render CodeExampleComponent.new(
                demo_code: '<div class="border--v-20">Vertical border</div>
<div class="border--v-65">Vertical border</div>'
              ) %>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Themed Borders') %>
          <p class="<%= framework_section_description_classes %>">
            Hue comes from the theme, not from a class: borders draw their classic patterns by default, and
            <code class="<%= framework_section_code_classes %>">theme-slots.utility-remap-border-grayscale($hue, $side)</code>
            recolors them (and
            <code class="<%= framework_section_code_classes %>">.divider</code>) without changing their shape.
            The <code class="<%= framework_section_code_classes %>">dark</code> side paints black on the hue,
            <code class="<%= framework_section_code_classes %>">bright</code> paints the hue on white.
            Pick a Style in the screen picker to watch the lines above repaint.
          </p>
          <p class="<%= framework_section_description_classes %>">
            2-bit borders are the exception: their four tones are drawn into the line itself, so a hue remap leaves
            them black, white, and two grays. That is deliberate: on a 4-tone panel a hue would print as gray anyway.
          </p>
          <p class="<%= framework_section_description_classes %>">
            A theme that wants to change the 2-bit borders swaps levels instead, with
            <code class="<%= framework_section_code_classes %>">theme-slots.utility-border-level($level, $dir, $from-level)</code>,
            the way the shipped Dark theme does. See <%= render DocsRef.new(page: :theme_slots) %>.
          </p>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(
            demo_code: '@include theme-slots.utility-remap-border-grayscale("yellow", $side: "dark");
@include theme-slots.utility-remap-border-grayscale("red", $side: "bright");'
          ) %>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Black & White Borders') %>
          <p class="<%= framework_section_description_classes %>">
            <code class="<%= framework_section_code_classes %>">border--h-black</code> and
            <code class="<%= framework_section_code_classes %>">border--h-white</code> adapt to themes
            automatically. They read the theme's strongest and softest fill colors, so they stay the
            darkest and lightest lines whatever the theme.
          </p>
        </div>

        <div class="space-y-4">
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout">
                      <div class="flex flex--row gap w--full h--full flex--stretch">
                        <div class="flex flex--col gap--space-between p--4 rounded bg--white">
                          <div class="item border--h-black">
                            <span class="label mb--2">black</span>
                          </div>
                          <div class="item border--h-white">
                            <span class="label mb--2">white</span>
                          </div>
                        </div>
                        <div class="flex flex--col gap--space-between p--4 rounded bg--black">
                          <div class="item border--h-black">
                            <span class="label mb--2 text--white">black</span>
                          </div>
                          <div class="item border--h-white">
                            <span class="label mb--2 text--white">white</span>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Black & White Borders</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<div class="border--h-black">Black border (strongest fill)</div>
<div class="border--h-white">White border (softest fill)</div>
<div class="border--v-black">Black vertical border</div>
<div class="border--v-white">White vertical border</div>'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Borders in JavaScript') %>
          <p class="<%= framework_section_description_classes %>">
            JavaScript can read the border lines too:
            <code class="<%= framework_section_code_classes %>">TRMNLPaint.border(spec, { dir })</code> returns the
            line for a step, or for <code class="<%= framework_section_code_classes %>">'black'</code> /
            <code class="<%= framework_section_code_classes %>">'white'</code>, with the theme, bit depth, and dark
            mode already applied.
            <code class="<%= framework_section_code_classes %>">applyBorder()</code> paints it onto a node. These
            lines stay visible in every mode, which makes them the reliable source for JS-drawn hairlines
            like chart grids; see <%= render DocsRef.new(page: :paint_borders) %>.
          </p>
        </div>
      </section>

      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
