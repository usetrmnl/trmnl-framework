<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :outline %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:outline) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Basic Usage') %>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Applying an Outline') %>
            <p class="<%= framework_subsection_description_classes %>">
              Add the <code class="<%= framework_section_code_classes %>">outline</code> class to any element
              to give it a pixel-perfect rounded border.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col layout--stretch gap--large">
                      <div class="flex flex--row flex--stretch gap">
                        <div class="flex flex--center-x flex--center-y bg--white outline stretch">
                          <span class="label">With outline</span>
                        </div>
                        <div class="flex flex--center-x flex--center-y bg--white rounded stretch">
                          <span class="label">Without outline</span>
                        </div>
                      </div>
                    </div>

                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                      <span class="title">Outline Utility</span>
                      <span class="instance">Design System</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<!-- Add outline to any element -->
<div class="outline">
  Content with pixel-perfect rounded border
</div>'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'How It Works') %>
          <p class="<%= framework_section_description_classes %>">
            The outline draws every dot with CSS backgrounds, 56 layers in total, so each dot lands on an exact
            pixel. Four edge layers repeat a 1px dot every 4px, and sixteen corner layers place one 1x1px dot
            each. The remaining 36 are corner fill-ins that stay invisible until a device with a dither pixel ratio
            of 2 or more turns them on.
          </p>
          <p class="<%= framework_section_description_classes %>">
            <code class="<%= framework_section_code_classes %>">dither-pixel-ratio</code> is a separate profile field
            from <code class="<%= framework_section_code_classes %>">pixel-ratio</code>. TRMNL V2 previews at pixel
            ratio 1.8 and still renders its art at double density, so it gets the fill-ins.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'CSS Gradient Dots') %>
            <p class="<%= framework_subsection_description_classes %>">
              No images are used. Each dot is computed mathematically by the CSS engine,
              guaranteeing pixel-grid alignment at any element size.
            </p>
            <p class="<%= framework_subsection_description_classes %>">
              The dot color is looked up in three steps, first one set wins:
              <code class="<%= framework_section_code_classes %>">--framework-semantic-border-strong-border-color</code>,
              then <code class="<%= framework_section_code_classes %>">--framework-outline-strong</code>,
              then <code class="<%= framework_section_code_classes %>">--framework-border-strong</code>.
              A theme sets the first through
              <code class="<%= framework_section_code_classes %>">theme-slots.semantic-border</code>, so dark mode
              and themes recolor the outline with no extra assets.
            </p>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '/* How the CSS works internally (simplified) */
.outline::after {
    background:
        /* Edges: repeating 1px dot every 4px */
        repeating-linear-gradient(to right, black 0 1px, transparent 1px 4px)
            12px 0 / calc(100% - 24px) 1px no-repeat,
        /* ... 3 more edges ... */
        /* Corners: individual 1x1px dots */
        linear-gradient(black, black) 8px 0 / 1px 1px no-repeat,
        linear-gradient(black, black) 4px 1px / 1px 1px no-repeat,
        /* ... 14 more corner dots ... */
        /* ... 36 high-DPI corner fill-ins ... */
}'
            ) %>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Bit-Depth Behavior') %>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, '1-bit Displays') %>
            <p class="<%= framework_subsection_description_classes %>">
              Uses pure CSS gradients to place sparse single-pixel dots at exact integer coordinates.
              Dark mode works automatically because
              <code class="<%= framework_section_code_classes %>">--framework-semantic-border-strong-border-color</code>
              flips to white.
            </p>
          </div>

          <div class="space-y-2 mt-6">
            <%= framework_heading(4, '2-bit and 4-bit Displays') %>
            <p class="<%= framework_subsection_description_classes %>">
              Draws a standard 1px solid border instead: with real grays available, a smooth line beats dots.
              The corner radius is 7px, scaled by the content scale.
            </p>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '/* 1-bit: CSS gradient dots (via outline-dots mixin) */
.outline::after {
    @include outline-dots;
}

/* 2-bit and 4-bit: Falls back to CSS border */
.screen--2bit .outline::after,
.screen--4bit .outline::after {
    background: none;
    border: 1px solid var(--framework-semantic-border-strong-border-color,
        var(--framework-outline-strong, var(--framework-border-strong)));
    border-radius: calc(7px * var(--content-scale, 1));
}'
            ) %>
          </div>
        </div>
      </section>

      <%= render 'framework/page_navigation' %>
    </div>
  </div>
</div>
