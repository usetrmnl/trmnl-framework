<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :devices %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:devices) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'What a Device Profile Is') %>
          <p class="<%= framework_section_description_classes %>">
            The framework turns each profile into a
            <code class="<%= framework_section_code_classes %>">screen--&lt;keyname&gt;</code> class. The class
            sets the profile as CSS variables on the
            <%= render DocsRef.new(page: :screen) %> element, and everything inside reads them.
          </p>
          <p class="<%= framework_section_description_classes %>">
            On the TRMNL platform you never write this class: the platform renders your layout against each
            device's own profile. Add it yourself only when you render the screen in your own stack.
          </p>
        </div>

        <div class="<%= framework_docs_table_wrapper_classes %>">
          <div class="<%= framework_docs_table_card_classes %>">
            <table class="<%= framework_docs_table_classes %>">
              <thead>
                <tr>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Variable</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">What it holds</th>
                </tr>
              </thead>
              <tbody class="<%= framework_docs_table_body_classes %>">
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm"><code class="<%= framework_section_code_classes %>">--screen-w</code>, <code class="<%= framework_section_code_classes %>">--screen-h</code></td>
                  <td class="px-6 py-4 text-sm">The panel's dimensions in CSS pixels. Every view and layout size derives from them.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm"><code class="<%= framework_section_code_classes %>">--pixel-ratio</code></td>
                  <td class="px-6 py-4 text-sm">Physical-to-CSS pixel ratio. The screen scales by it, so a 2x panel still lays out in CSS pixels.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm"><code class="<%= framework_section_code_classes %>">--dither-pixel-ratio</code></td>
                  <td class="px-6 py-4 text-sm">The ratio dither patterns render at, so they stay crisp on high-DPI panels.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm"><code class="<%= framework_section_code_classes %>">--device-ui-scale</code></td>
                  <td class="px-6 py-4 text-sm">The device's own interface scale. It multiplies with the Scale modifier to produce <code class="<%= framework_section_code_classes %>">--ui-scale</code>.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm"><code class="<%= framework_section_code_classes %>">--gap-scale</code></td>
                  <td class="px-6 py-4 text-sm">Multiplier on every gap variable, for panels that need tighter or looser spacing than their size class gives.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm"><code class="<%= framework_section_code_classes %>">--device-name</code></td>
                  <td class="px-6 py-4 text-sm">The profile keyname as a string.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm"><code class="<%= framework_section_code_classes %>">--color-depth</code></td>
                  <td class="px-6 py-4 text-sm">The profile's depth rating, as metadata.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="space-y-4">
          <p class="<%= framework_section_description_classes %>">
            <code class="<%= framework_section_code_classes %>">--color-depth</code> paints nothing. What a screen
            prints is decided by its mode class, so a profile rated 24 still renders in grayscale the moment it
            carries a grayscale class. See <%= render DocsRef.new(page: :rendering_modes) %>.
          </p>
          <p class="<%= framework_section_description_classes %>">
            <%= render DocsRef.new(page: :tokens) %> lists these variables with their defaults, next to every other
            framework token.
          </p>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(
            demo_code: <<~'HTML'.strip
              <!-- TRMNL X: 1040x780 CSS pixels at a 1.8 pixel ratio, 16 grays -->
              <div class="screen screen--v2 screen--lg screen--density-2x screen--4bit">
                <div class="view view--full">
                  <div class="layout">...</div>
                </div>
              </div>
            HTML
          ) %>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Size and Density') %>
          <p class="<%= framework_section_description_classes %>">
            Every profile names a size (<code class="<%= framework_section_code_classes %>">sm</code>,
            <code class="<%= framework_section_code_classes %>">md</code>, or
            <code class="<%= framework_section_code_classes %>">lg</code>) and a density tier
            (<code class="<%= framework_section_code_classes %>">1x</code> or
            <code class="<%= framework_section_code_classes %>">2x</code>). The device class includes both, so their
            variables come with it.
          </p>
          <p class="<%= framework_section_description_classes %>">
            Keep the size and density classes on the screen anyway: the responsive prefixes and the runtime match
            those classes.
            <code class="<%= framework_section_code_classes %>">md:value--large</code> matches
            <code class="<%= framework_section_code_classes %>">screen--md</code>, never the device class that includes
            it. <%= render DocsRef.new(page: :responsive) %> covers the size grammar.
          </p>
          <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
            <li><code class="<%= framework_section_code_classes %>">screen--sm</code>, <code class="<%= framework_section_code_classes %>">screen--md</code>, <code class="<%= framework_section_code_classes %>">screen--lg</code>: the breakpoint the device sits at, and the rich text width that goes with it.</li>
            <li><code class="<%= framework_section_code_classes %>">screen--density-2x</code>: high-DPI typography, which switches the pixel fonts for Inter Variable. See <%= render DocsRef.new(page: :font_family) %>.</li>
            <li>Low density is the default and needs no class. <code class="<%= framework_section_code_classes %>">screen--density-1x</code> exists only as a marker; no CSS rule reads it.</li>
          </ul>
          <p class="<%= framework_section_description_classes %>">
            Pick the size by the devices you want to hit rather than by a pixel count. A profile's own
            <code class="<%= framework_section_code_classes %>">--device-ui-scale</code> and
            <code class="<%= framework_section_code_classes %>">--gap-scale</code> handle the fine tuning inside a size.
          </p>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Palettes Select the Mode, Not the Geometry') %>
          <p class="<%= framework_section_description_classes %>">
            A device lists every palette it can print. The palette chosen for a render decides the mode class;
            the dimensions stay the device's either way.
          </p>
          <p class="<%= framework_section_description_classes %>">
            <%= render DocsRef.new(page: :color_palettes) %> lists the palettes and their classes.
          </p>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(
            demo_code: <<~'HTML'.strip
              <!-- The gray-16 palette: shades paint as solids -->
              <div class="screen screen--amazon_kindle_2024 screen--sm screen--density-2x screen--4bit">...</div>

              <!-- The bw palette, same device: shades paint as dither patterns -->
              <div class="screen screen--amazon_kindle_2024 screen--sm screen--density-2x screen--1bit">...</div>
            HTML
          ) %>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Rating a Panel') %>
          <p class="<%= framework_section_description_classes %>">
            Rate a panel by what the glass can show, not by the format the image arrives in. These are the four
            hardware classes and the depth each one takes.
          </p>
        </div>

        <div class="<%= framework_docs_table_wrapper_classes %>">
          <div class="<%= framework_docs_table_card_classes %>">
            <table class="<%= framework_docs_table_classes %>">
              <thead>
                <tr>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Hardware class</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Depth</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Palettes it can carry</th>
                </tr>
              </thead>
              <tbody class="<%= framework_docs_table_body_classes %>">
                <tr>
                  <td class="px-6 py-4 text-sm">Grayscale e-paper</td>
                  <td class="px-6 py-4 text-sm">1, 2, or 4</td>
                  <td class="px-6 py-4 text-sm">By gray levels: 2 levels rate 1, 4 levels rate 2, 16 levels rate 4. Each panel carries the grayscale palettes up to its own level.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-sm">Limited-color e-paper</td>
                  <td class="px-6 py-4 text-sm">1</td>
                  <td class="px-6 py-4 text-sm">Its own ink set, every smaller ink set it can print, and <code class="<%= framework_section_code_classes %>">bw</code>.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-sm">Kaleido-class color e-paper</td>
                  <td class="px-6 py-4 text-sm">12</td>
                  <td class="px-6 py-4 text-sm"><code class="<%= framework_section_code_classes %>">color-12bit</code>, which renders through <code class="<%= framework_section_code_classes %>">screen--color-full</code>.</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 text-sm">LCD, OLED, browser, virtual</td>
                  <td class="px-6 py-4 text-sm">24</td>
                  <td class="px-6 py-4 text-sm">Every palette, including <code class="<%= framework_section_code_classes %>">color-24bit</code>. These panels can render any mode the framework has.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="space-y-4">
          <p class="<%= framework_section_description_classes %>">
            Grayscale ratings stop at 4: past 16 grays the next step is color, so a panel rates 12 or 24
            instead of a deeper gray.
          </p>
          <p class="<%= framework_section_description_classes %>">
            A smooth 8-bit image on the wire is a delivery format, not a rating. The panel behind it still
            prints 16 grays, so the screen still renders on
            <code class="<%= framework_section_code_classes %>">screen--4bit</code>.
          </p>
          <p class="<%= framework_section_description_classes %>">
            A full-color rating does not lock a device into color. Rate the profile for the glass, then render it with
            whichever mode class the palette selects.
          </p>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'The Shipped Device Classes') %>
          <p class="<%= framework_section_description_classes %>">
            Every profile in the registry ships a class. Devices with identical dimensions share one: nine of
            them resolve to
            <code class="<%= framework_section_code_classes %>">screen--og</code> or
            <code class="<%= framework_section_code_classes %>">screen--ogv2</code>.
          </p>
        </div>

        <% device_classes = Framework::Devices.device_specs.group_by { |spec| spec.dig('css', 'keyname') } %>
        <div class="<%= framework_docs_table_wrapper_classes %>">
          <div class="<%= framework_docs_table_card_classes %>">
            <table class="<%= framework_docs_table_classes %>">
              <thead>
                <tr>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Class</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Devices</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Size</th>
                  <th class="<%= framework_docs_table_header_cell_classes %>">Depth</th>
                </tr>
              </thead>
              <tbody class="<%= framework_docs_table_body_classes %>">
                <% device_classes.sort_by { |keyname, _| keyname.to_s }.each do |keyname, specs| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm"><code class="<%= framework_section_code_classes %>">screen--<%= keyname %></code></td>
                    <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400"><%= specs.map { |spec| spec['name'] }.join(', ') %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400"><%= specs.first.dig('css', 'size') %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400"><%= specs.first.dig('css', 'bit_depth') %>-bit</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Where Profiles Come From') %>
          <p class="<%= framework_section_description_classes %>">
            The framework ships the platform's device list as generated SCSS. A released build carries a
            class for every device the platform knows; the framework never invents one.
          </p>
          <p class="<%= framework_section_description_classes %>">
            Bring your own panel in one of two ways. Apply
            <code class="<%= framework_section_code_classes %>">screen--byod_custom</code>, the generic profile every
            build ships, or compile the framework with your exact values in
            <code class="<%= framework_section_code_classes %>">$custom-devices</code>.
          </p>
          <p class="<%= framework_section_description_classes %>">
            <%= render DocsRef.new(page: :sass_devices) %> has the profile schema, the compile-time validation, and what
            a configured profile generates.
          </p>
        </div>
      </section>
    </div>

    <%= render 'framework/page_navigation' %>
  </div>
</div>
