<% return unless framework_related_tokens_section? %>
<% related_tokens = related_tokens_for_page %>

<section class="space-y-4">
  <%= framework_heading(3, 'Related Tokens') %>
  <p class="<%= framework_section_description_classes %>">
    These tokens are automatically mapped to this page by token prefix.
  </p>

  <% collapsible = related_tokens.size > 10 %>
  <div class="<%= framework_docs_table_wrapper_classes %>"
       <% if collapsible %>
         data-controller="related-tokens"
         data-related-tokens-show-label-value="Show all <%= related_tokens.size %> tokens"
         data-related-tokens-hide-label-value="Show fewer"
       <% end %>>
    <%# While collapsed, the overflow-hidden frame becomes the sticky headers'
        scroll container and xl:top-11 would shove them 44px down the card, so
        the frame forces them static until expanded. %>
    <div <% if collapsible %>class="relative max-h-[36rem] overflow-hidden [&_th]:static" data-related-tokens-target="frame"<% end %>>
    <div class="<%= framework_docs_table_card_classes %>">
      <table class="<%= framework_docs_table_classes %> table-fixed">
        <colgroup>
          <col class="w-[28%]">
          <col class="w-[18%]">
          <col class="w-[18%]">
          <col class="w-[18%]">
          <col class="w-[18%]">
        </colgroup>
        <thead>
          <tr>
            <th class="<%= framework_docs_table_header_cell_classes %>">Token</th>
            <th class="<%= framework_docs_table_header_cell_classes %>">1-bit</th>
            <th class="<%= framework_docs_table_header_cell_classes %>">2-bit</th>
            <th class="<%= framework_docs_table_header_cell_classes %>">Density 2x</th>
            <th class="<%= framework_docs_table_header_cell_classes %>">4-bit and up</th>
          </tr>
        </thead>
        <tbody class="<%= framework_docs_table_body_classes %>">
          <% category = related_tokens.first&.dig(:category) %>
          <% framework_token_variant_groups(related_tokens, category).each do |variant_label, variant_tokens| %>
            <% if variant_label %>
              <tr>
                <td colspan="5" class="px-4 py-2 text-xs font-medium uppercase tracking-wider text-gray-400 dark:text-gray-500 bg-gray-100/50 dark:bg-gray-800/30"><%= variant_label %></td>
              </tr>
            <% end %>
            <% variant_tokens.each do |row| %>
              <% inherits_2bit = row[:override_2bit].blank? && row[:root_value].present? %>
              <% inherits_density = row[:override_density_2x].blank? && (row[:override_2bit].present? || row[:root_value].present?) %>
              <% inherits_density_from = row[:override_2bit].present? ? '2-bit' : '1-bit' %>
              <% inherits_4bit = row[:override_4bit_plus].blank? && (row[:override_2bit].present? || row[:root_value].present?) %>
              <% inherits_4bit_from = row[:override_2bit].present? ? '2-bit' : '1-bit' %>
              <tr id="<%= framework_token_anchor(row[:token_name]) %>" class="<%= framework_docs_table_row_classes %>">
                <td class="<%= framework_docs_table_cell_emphasis_classes %>">
                  <code class="text-sm font-mono text-syntax-string break-words"><%= row[:token_name] %></code>
                </td>
                <td class="<%= framework_docs_table_cell_classes %>">
                  <span class="block break-words text-xs font-mono text-gray-500 dark:text-gray-400"><%= row[:root_value] || '-' %></span>
                </td>
                <td class="<%= framework_docs_table_cell_classes %>">
                  <% if inherits_2bit %>
                    <span class="block break-words text-xs font-mono text-gray-400 dark:text-gray-600" title="inherits 1-bit" aria-label="Inherits 1-bit">-</span>
                  <% else %>
                    <span class="block break-words text-xs font-mono text-gray-500 dark:text-gray-400"><%= row[:override_2bit] || '-' %></span>
                  <% end %>
                </td>
              <td class="<%= framework_docs_table_cell_classes %>">
                <% if inherits_density %>
                  <span class="block break-words text-xs font-mono text-gray-400 dark:text-gray-600" title="inherits <%= inherits_density_from %>" aria-label="Inherits <%= inherits_density_from %>">-</span>
                <% else %>
                  <span class="block break-words text-xs font-mono text-gray-500 dark:text-gray-400"><%= row[:override_density_2x] || '-' %></span>
                <% end %>
              </td>
                <td class="<%= framework_docs_table_cell_classes %>">
                  <% if inherits_4bit %>
                    <span class="block break-words text-xs font-mono text-gray-400 dark:text-gray-600" title="inherits <%= inherits_4bit_from %>" aria-label="Inherits <%= inherits_4bit_from %>">-</span>
                  <% else %>
                    <span class="block break-words text-xs font-mono text-gray-500 dark:text-gray-400"><%= row[:override_4bit_plus] || '-' %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if collapsible %>
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-gray-100 dark:from-gray-800 to-transparent pointer-events-none" data-related-tokens-target="fade"></div>
    <% end %>
    </div>
    <% if collapsible %>
      <div class="flex justify-center mt-3">
        <button type="button" data-related-tokens-target="toggle" data-action="related-tokens#toggle"
                class="text-sm font-medium text-gray-600 dark:text-gray-300 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-1.5 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
          Show all <%= related_tokens.size %> tokens
        </button>
      </div>
    <% end %>
  </div>
</section>
