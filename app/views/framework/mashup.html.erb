                        </div>
                      </div>
                    </div>
                    <div class="mashup-cell">
                      <div class="view view--quadrant">
                        <div class="layout">
                          <span class="label">Plugin G</span>
                        </div>
                      </div>
                    </div>
                    <div class="mashup-cell">
                      <div class="view view--quadrant">
                        <div class="layout">
