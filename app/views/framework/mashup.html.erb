        <!-- Feature and Sidebar -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Feature and Sidebar') %>
            <p class="<%= framework_subsection_description_classes %>">
              Add <code class="<%= framework_section_code_classes %>">mashup-cell--col-*</code> and
              <code class="<%= framework_section_code_classes %>">mashup-cell--row-*</code> to choose the starting
