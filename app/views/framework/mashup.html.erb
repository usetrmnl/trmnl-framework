  <div class="mashup-cell mashup-cell--col-1 mashup-cell--col-span-3 mashup-cell--row-1 mashup-cell--row-span-1">
    <div class="view view--half_horizontal">
      <div class="layout">
        <span class="label">Plugin A</span>
      </div>
    </div>
  </div>
  <div class="mashup-cell mashup-cell--col-1 mashup-cell--col-span-2 mashup-cell--row-2 mashup-cell--row-span-2">
    <div class="view view--full">
      <div class="layout">
        <span class="label">Plugin B</span>
      </div>
    </div>
  </div>
  <div class="mashup-cell mashup-cell--col-3 mashup-cell--col-span-1 mashup-cell--row-2 mashup-cell--row-span-2">
    <div class="view view--half_vertical">
      <div class="layout">
        <span class="label">Plugin C</span>
      </div>
    </div>
  </div>
</div>'
            ) %>
          </div>
        </div>

        <!-- Title Bars -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Title Bars') %>
            <p class="<%= framework_subsection_description_classes %>">
              Add a <%= render DocsRef.new(page: :title_bar) %> to a cell to label its plugin. Place the
              <code class="<%= framework_section_code_classes %>">title_bar</code> as a sibling of
              <code class="<%= framework_section_code_classes %>">layout</code> inside the view, the same as a
              standalone view. Every cell uses the compact title bar, whatever its size, and the layout above
              shrinks to make room for it.
            </p>
          </div>
          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="mashup mashup--3x3">
                    <div class="mashup-cell mashup-cell--col-1 mashup-cell--col-span-2 mashup-cell--row-1 mashup-cell--row-span-1">
                      <div class="view view--half_horizontal">
                        <div class="layout">
                          <span class="value">72&deg;</span>
                        </div>
                        <div class="title_bar">
                          <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image image--adaptive", alt: "TRMNL Logo" %>
                          <span class="title">Weather</span>
                        </div>
                      </div>
                    </div>
                    <div class="mashup-cell mashup-cell--col-3 mashup-cell--col-span-1 mashup-cell--row-1 mashup-cell--row-span-2">
