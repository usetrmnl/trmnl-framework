<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework/page_header', page_name: :paint_api %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:paint_api) %>

    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'How it works') %>
          <p class="<%= framework_section_description_classes %>">
            The framework paints every surface through per-mode CSS custom properties on the
            <code class="<%= framework_section_code_classes %>">.screen</code> element, and a theme is CSS that
            re-points those properties. <code class="<%= framework_section_code_classes %>">TRMNLPaint</code> is a
            reader of that live cascade, never a second definition of the color system.
          </p>
          <p class="<%= framework_section_description_classes %>">
            Each resolver appends a hidden probe element inside the target element, applies the framework's own
            utility class (<code class="<%= framework_section_code_classes %>">bg--&lt;token&gt;</code>,
            <code class="<%= framework_section_code_classes %>">text--&lt;token&gt;</code>, ...), and reads back the
            browser-resolved computed style. Bit depth, dark mode, inverse subtrees that flip the screen scheme, themes, slot overrides, and
            limited palettes are all honoured automatically, with zero token mappings duplicated in JavaScript.
          </p>
          <p class="<%= framework_section_description_classes %>">
            Every function is total: a missing <code class="<%= framework_section_code_classes %>">.screen</code> or
            an unknown token returns a Fill with null fields instead of throwing. Plugins render on a screenshot
            service, and a thrown error would mean a blank device screen.
          </p>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'The paint domains') %>
          <p class="<%= framework_section_description_classes %>">
            The resolvers are documented by what they paint. Every resolver takes an optional
            <code class="<%= framework_section_code_classes %>">{ el }</code>: the id or element whose local cascade
            supplies the paint, with device settings from its nearest
            <code class="<%= framework_section_code_classes %>">.screen</code>. Omit it on a single-screen plugin
            and the first screen on the page is used.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <%= render FrameworkDocCardComponent.new(icon: :colors, title: 'Painting Colors', docs_page: :paint_colors) do %>
            <p class="<%= framework_subsection_description_classes %>">Resolve background, text, stroke, and semantic tokens as Fills, and paint them onto nodes.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li><code class="<%= framework_section_code_classes %>">bg()</code>, <code class="<%= framework_section_code_classes %>">text()</code>, <code class="<%= framework_section_code_classes %>">stroke()</code></li>
              <li><code class="<%= framework_section_code_classes %>">semantic()</code>, <code class="<%= framework_section_code_classes %>">textColor()</code></li>
              <li><code class="<%= framework_section_code_classes %>">apply()</code></li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :chart, title: 'Painting Charts', docs_page: :paint_charts) do %>
            <p class="<%= framework_subsection_description_classes %>">Series colors from the screen's chart ramp, and the Highcharts fill adapter.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li><code class="<%= framework_section_code_classes %>">series()</code>, <code class="<%= framework_section_code_classes %>">ramp()</code></li>
              <li><code class="<%= framework_section_code_classes %>">toHighcharts()</code></li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :border, title: 'Painting Borders', docs_page: :paint_borders) do %>
            <p class="<%= framework_subsection_description_classes %>">Border and divider rails as BorderFills, for custom rails and Highcharts axes.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li><code class="<%= framework_section_code_classes %>">border()</code>, <code class="<%= framework_section_code_classes %>">divider()</code></li>
              <li><code class="<%= framework_section_code_classes %>">applyBorder()</code></li>
              <li><code class="<%= framework_section_code_classes %>">toHighchartsAxis()</code>, <code class="<%= framework_section_code_classes %>">applyHighchartsAxisPaint()</code></li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :text, title: 'Painting Typography', docs_page: :paint_typography) do %>
            <p class="<%= framework_subsection_description_classes %>">Text roles and stroke rings as TypeSpecs, for custom text and chart labels.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li><code class="<%= framework_section_code_classes %>">type()</code>, <code class="<%= framework_section_code_classes %>">strokeSpec()</code></li>
              <li><code class="<%= framework_section_code_classes %>">applyType()</code></li>
              <li><code class="<%= framework_section_code_classes %>">toHighchartsText()</code></li>
            </ul>
          <% end %>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Scale values') %>
          <p class="<%= framework_section_description_classes %>">
            Resolve scale-aware JavaScript dimensions through <code class="<%= framework_section_code_classes %>">TRMNLPaint</code>. It reads the same custom properties as the CSS framework, so device density, Scale, and Text Scale stay in one source of truth.
          </p>

          <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
            <li>
              <code class="<%= framework_section_code_classes %>">scale({ el })</code>: returns <code class="<%= framework_section_code_classes %>">{ name, device, modifier, ui, content, textName, textModifier, textUi }</code> for the target screen.
            </li>
            <li>
              <code class="<%= framework_section_code_classes %>">px(value, { el, kind })</code>: scales one number or an array of numbers. It uses content scale by default; pass <code class="<%= framework_section_code_classes %>">kind: "ui"</code> for framework geometry or <code class="<%= framework_section_code_classes %>">kind: "text"</code> for framework typography.
            </li>
          </ul>

          <p class="<%= framework_section_description_classes %>">
            Use <code class="<%= framework_section_code_classes %>">px()</code> for numeric chart options, canvas dimensions, and other library configuration. Percentages, data values, zero-width rails, and physical one-pixel strokes should remain unchanged.
          </p>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(demo_code: 'var scale = TRMNLPaint.scale({ el: "my-chart" });
var height = TRMNLPaint.px(260, { el: "my-chart" });
var spacing = TRMNLPaint.px([10, 10, 5, 10], { el: "my-chart" });

// Framework-owned component geometry also includes device density.
var componentInset = TRMNLPaint.px(6, { el: "my-chart", kind: "ui" });

// Framework typography includes device density, Scale, and Text Scale.
var fontSize = TRMNLPaint.px(16, { el: "my-chart", kind: "text" });', language: 'javascript') %>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'The Fill type') %>
          <p class="<%= framework_section_description_classes %>">
            Every resolver returns a canonical <code class="<%= framework_section_code_classes %>">Fill</code>, a
            plain object describing paint independently of any charting library. A Fill with a
            <code class="<%= framework_section_code_classes %>">url</code> and
            <code class="<%= framework_section_code_classes %>">size</code> is a dither tile pattern; a Fill with only
            a <code class="<%= framework_section_code_classes %>">color</code> is a solid. Library-specific shaping
            lives in adapters, never in the Fill.
          </p>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(demo_code: 'Fill = {
  color: string | null,  // resolved "rgb(...)" flat / field color
  image: string | null,  // full resolved background-image; null when "none"
  url:   string | null,  // first url(...) from image; null for gradients / solids
  size:  number | null,  // tile size in px (falls back to --dither-bg-size)
}

// url && size  => a dither tile pattern
// color only   => a solid', language: 'javascript') %>
        </div>

        <div class="space-y-4 mt-4">
          <p class="<%= framework_section_description_classes %>">
            Borders and typography have richer shapes: <code class="<%= framework_section_code_classes %>">BorderFill</code>
            is documented on <%= render DocsRef.new(page: :paint_borders) %> and
            <code class="<%= framework_section_code_classes %>">TypeSpec</code> on
            <%= render DocsRef.new(page: :paint_typography) %>.
          </p>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Painting and reactivity') %>
          <ul class="<%= framework_section_description_classes %> list-disc pl-6 space-y-2">
            <li>
              <code class="<%= framework_section_code_classes %>">apply(node, fill)</code>: paints a node's background
              from a Fill, compositing the field color under the tile image with the same two-layer CSS the rest of
              the screen uses.
            </li>
            <li>
              <code class="<%= framework_section_code_classes %>">watch(el, onChange, { immediate })</code>: runs
              <code class="<%= framework_section_code_classes %>">onChange</code> now (unless
              <code class="<%= framework_section_code_classes %>">immediate: false</code>) and again whenever the
              mode, dark or theme classes change on the screen or on a wrapper above it. Returns a
              <code class="<%= framework_section_code_classes %>">stop()</code> function.
            </li>
            <li>
              <code class="<%= framework_section_code_classes %>">screen(el)</code>: the nearest
              <code class="<%= framework_section_code_classes %>">.screen</code> for a target element, or the first
              screen on the page.
            </li>
          </ul>
          <p class="<%= framework_section_description_classes %>">
            <code class="<%= framework_section_code_classes %>">applyBorder()</code> and
            <code class="<%= framework_section_code_classes %>">applyType()</code> write border and typography
            longhands the same way; they are documented with their resolvers on
            <%= render DocsRef.new(page: :paint_borders) %> and <%= render DocsRef.new(page: :paint_typography) %>.
          </p>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Extending a theme from JavaScript') %>
          <p class="<%= framework_section_description_classes %>">
            Themes never ship JavaScript. A theme that needs to expose extra values to plugin code (a brand accent, a
            custom ramp) publishes additional public
            <code class="<%= framework_section_code_classes %>">--*</code> custom properties on the screen, and JS
            reads them back with <code class="<%= framework_section_code_classes %>">cssVar()</code>. No framework
            release and no JS bundle per theme: just CSS that both worlds read.
          </p>
          <p class="<%= framework_section_description_classes %>">
            <code class="<%= framework_section_code_classes %>">cssVar(name, { el })</code> returns the trimmed
            computed value of any public custom property on the screen. It is the documented escape hatch for exactly
            these theme-published values.
          </p>
          <div class="<%= message_sage_classes %>">
            <div class="flex items-center w-full">
              <div class="flex-shrink-0 items-center">
                <%= render 'shared/icons/info' %>
              </div>
              <div class="w-full flex items-center justify-between ml-3">
                <p class="text-sm font-medium">
                  Read public var families only. The CSS minifier renames private variables
                  (<code class="<%= framework_section_code_classes %>">--_*</code>,
                  <code class="<%= framework_section_code_classes %>">--framework-internal-*</code>,
                  <code class="<%= framework_section_code_classes %>">--tile-*</code>,
                  <code class="<%= framework_section_code_classes %>">--bline-*</code>, most of
                  <code class="<%= framework_section_code_classes %>">--border-*</code> and
                  <code class="<%= framework_section_code_classes %>">--tn-*</code>) in the released
                  <code class="<%= framework_section_code_classes %>">plugins.min.css</code>; the readable
                  <code class="<%= framework_section_code_classes %>">plugins.css</code> keeps the source names. Never
                  read those families from JS.
                  <code class="<%= framework_section_code_classes %>">cssVar("--border-step-40-h-color")</code>
                  answers in the dev build and returns an empty string against every release. See
                  <%= render DocsRef.new(page: :variables_api) %> for the families that survive.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <%= render CodeExampleComponent.new(demo_code: '// A theme publishes a public var on .screen--theme-my-brand:
//   --my-brand-accent: var(--red-50);
// Read it back from JS, resolved for the active mode/theme:
var accent = TRMNLPaint.cssVar("--my-brand-accent", { el: "my-chart" });', language: 'javascript') %>
        </div>
      </section>
    </div>

    <%= render 'framework/page_navigation' %>
  </div>
</div>
