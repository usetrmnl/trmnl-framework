<%# _sidebar.html.erb - Unified sidebar component for both left and right sidebars %>
<div id="<%= sidebar_type == 'left' ? 'left-sidebar-nav' : nil %>" class="w-full h-full overflow-y-auto overflow-x-hidden">
  <% if sidebar_type == "left" %>
    <%# LEFT SIDEBAR CONTENT - Navigation menu %>
    <div class="p-4 space-y-6">
      <% framework_nav_groups.each do |group, pages| %>
        <div class="space-y-2">
          <h3 class="text-xs font-mono font-bold text-gray-500 dark:text-gray-600 uppercase tracking-widest px-2"><%= group.to_s.titleize %></h3>
          <ul class="space-y-1">
            <% pages.each do |page| %>
              <li>
                <%= link_to framework_page_path(page),
                    class: "block px-2 py-1.5 rounded-md text-xs tracking-[.01em] #{framework_page_active?(page) ? (framework_guide_page?(page) ? 'bg-sage-100 dark:bg-sage-900/30 text-sage-700 dark:text-sage-400 font-medium' : 'bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-400 font-medium') : 'text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'}" do %>
                  <div class="flex items-center">
                    <span class="mr-2 flex-shrink-0 w-5 h-5">
                      <%= page_icon(page, "w-full h-full") %>
                    </span>
                    <span class="flex items-center gap-1">
                      <%= page_titles[page] || page.to_s.titleize %>
                      <% if framework_beta?(page) %>
                        <span class="ml-0.5 <%= framework_badge_primary_sm_classes %>">Beta</span>
                      <% end %>
                    </span>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# RIGHT SIDEBAR CONTENT - Table of contents %>
    <div id="table-of-contents" class="p-4 h-full">
      <h3 class="text-xs font-mono font-bold text-gray-500 dark:text-gray-600 uppercase tracking-widest px-2 mb-4">On this page</h3>
      <div class="js-toc-content space-y-2 text-sm overflow-y-auto">
        <!-- This content will be dynamically generated by JavaScript -->
        <div class="toc-placeholder text-gray-400 italic">Loading table of contents...</div>
      </div>
    </div>
  <% end %>
</div> 
