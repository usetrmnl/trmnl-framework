<%# Copy Page dropdown button.
    Every item here reads the page's .md twin. `rake framework:generate_markdown`
    writes those under the engine's own public/, they are gitignored, and neither
    bin/setup nor bin/dev runs the task, so a fresh clone has none. The menu is
    rendered only where the file the links point at exists; copy_page_controller
    keeps its own 404 check as a backstop for a twin removed after render. %>
<% markdown_twin = Framework.public_root.join("#{request.path.delete_prefix('/')}.md") %>
<% if markdown_twin.file? %>
<div class="relative" data-controller="copy-page">
  <button data-action="click->copy-page#toggle"
          class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg
                 border border-gray-300 dark:border-gray-650
                 text-gray-700 dark:text-gray-300
                 hover:bg-gray-100 dark:hover:bg-gray-700
                 transition-colors duration-150">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
    </svg>
    <span data-copy-page-target="buttonText">Copy page</span>
    <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div data-copy-page-target="dropdown"
       class="absolute right-0 mt-1 w-48 rounded-lg shadow-lg z-50
              bg-white dark:bg-gray-800
              border border-gray-200 dark:border-gray-650
              py-1"
       hidden>
    <button data-action="click->copy-page#copyMarkdown"
            class="w-full text-left px-3 py-2 text-xs text-gray-700 dark:text-gray-300
                   hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
      Copy as Markdown
    </button>
    <a href="<%= request.path %>.md" target="_blank"
       data-action="click->copy-page#viewMarkdown"
       class="block px-3 py-2 text-xs text-gray-700 dark:text-gray-300
              hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
      View as Markdown
    </a>
    <button data-action="click->copy-page#copyLink"
            class="w-full text-left px-3 py-2 text-xs text-gray-700 dark:text-gray-300
                   hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
      Copy Markdown link
    </button>
  </div>
</div>
<% end %>
