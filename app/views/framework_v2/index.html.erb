<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <div class="my-4">
      <%= render 'shared/heading', title: 'UI Framework' %>
    </div>
    <p class="text-base text-gray-600 dark:text-gray-400 mt-2">
      Build consistent, high-quality plugin layouts with our ePaper optimized framework
    </p>
  </div>

  <div class="<%= layout_single_col_classes %>">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Docs Column -->
      <% doc_icon = capture do %>
        <svg class="w-6 h-6 text-primary-500 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      <% end %>
      <%= render 'framework_v2/framework_card',
        url: framework_docs_index_path,
        title: 'Docs',
        description: 'Complete documentation for components, utilities, and guides',
        badge: "#{FrameworkController::GROUPS[:docs].values.flatten.count} pages",
        icon_content: doc_icon %>

      <!-- Examples Column -->
      <% examples_icon = capture do %>
        <svg class="w-6 h-6 text-primary-500 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      <% end %>
      <%= render 'framework_v2/framework_card',
        url: framework_examples_index_path,
        title: 'Examples',
        description: 'Explore real-world plugin layout demonstrations',
        badge: "#{layout_examples_config.count} plugins",
        icon_content: examples_icon %>
    </div>
  </div>
</div>

<script type="text/javascript">
// ensures all Framework docs load as intended, with terminalize() being invoked
Array.from(document.querySelectorAll('[href*="/framework/"]')).forEach(docs => { docs.dataset.turbo = false; })
</script>
