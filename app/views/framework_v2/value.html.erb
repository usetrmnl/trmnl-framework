          <%= framework_heading(3, 'Numerical Display') %>
          <p class="<%= framework_section_description_classes %>">
            The Value system includes special formatting options for numerical values.
          </p>
        </div>

        <!-- Tabular Numbers -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Tabular Numbers') %>
            <p class="<%= framework_subsection_description_classes %>">
              Add the <code class="<%= framework_section_code_classes %>">value--tnums</code> modifier to enable tabular numbers.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap--large">
                      <span class="value value--large">Regular: 48,206.62</span>
                      <span class="value value--large value--tnums">Tabular: 48,206.62</span>
                    </div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                      <span class="title">Value</span>
                      <span class="instance">Tabular Numbers</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<span class="value value--large">Regular: 48,206.62</span>
<span class="value value--large value--tnums">Tabular: 48,206.62</span>'
            ) %>
          </div>
        </div>
      </section>

      <section id="responsive-values" class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Responsive Values') %>
          <p class="<%= framework_section_description_classes %>">
            The Value system supports responsive variants using breakpoint prefixes.
          </p>
        </div>

        <!-- Responsive Example -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Breakpoint Prefixes') %>
            <p class="<%= framework_subsection_description_classes %>">
              Use breakpoint prefixes like <code class="<%= framework_section_code_classes %>">sm:</code>,
              <code class="<%= framework_section_code_classes %>">md:</code>, <code class="<%= framework_section_code_classes %>">lg:</code>
              to apply different sizes at different screen widths.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap--large">
                      <span class="value value--small md:value--large lg:value--xlarge">Responsive Value</span>
                      <span class="value value--xsmall sm:value--small md:value--medium lg:value--large value--tnums">1,234.56</span>
                    </div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                      <span class="title">Value</span>
                      <span class="instance">Responsive</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<!-- Small by default, large on md screens, xlarge on lg screens -->
<span class="value value--small md:value--large lg:value--xlarge">
  Responsive Value
</span>

<!-- Progressive scaling with screen size -->
<span class="value value--xsmall sm:value--small md:value--medium lg:value--large value--tnums">
  1,234.56
</span>

<!-- Using base modifier to reset to default size at breakpoint -->
<span class="value value--small lg:value--base">
  Small by default, base on large screens
</span>'
            ) %>
          </div>
        </div>

        <!-- Orientation and Size+Orientation -->
        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Orientation and Size+Orientation') %>
            <p class="<%= framework_subsection_description_classes %>">
              Value sizes can adapt to orientation with <code class="<%= framework_section_code_classes %>">portrait:</code> and can be combined
              with size breakpoints (e.g., <code class="<%= framework_section_code_classes %>">md:portrait:</code>).
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout layout--col gap--large">
                      <!-- Orientation only -->
                      <span class="value value--large portrait:value--small">Orientation Variant</span>
                      <!-- Size + orientation -->
                      <span class="value value--small md:portrait:value--xlarge value--tnums">42,000.00</span>
                    </div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                      <span class="title">Value</span>
                      <span class="instance">Orientation</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<!-- Orientation only: smaller in portrait -->
<span class="value value--large portrait:value--small">Orientation Variant</span>

<!-- Size + orientation: xlarge only on md+ screens in portrait -->
<span class="value value--small md:portrait:value--xlarge value--tnums">42,000.00</span>'
            ) %>
          </div>
        </div>
      </section>
      <%= render 'framework_v2/page_navigation' %>
    </div>
  </div>
