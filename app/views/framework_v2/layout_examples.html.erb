<% meta title: 'Layout Examples' %>

<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework_v2/page_header', page_name: :layout_examples %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:layout_examples) %>
    
    <div class="space-y-16">
      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Available Examples') %>
          <p class="<%= framework_section_description_classes %>">
            Browse real plugin examples to see how the same data adapts across different mashup views (full, quadrant, half vertical, half horizontal).
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% layout_examples_config.each do |keyname, config| %>
            <% plugin = example_plugins_by_keyname[keyname] %>
            <% next unless plugin %>
            <% example_path = config[:variant].present? ? framework_example_show_path(id: keyname, variant: config[:variant]) : framework_example_show_path(id: keyname) %>
            <%= link_to example_path, data: { turbo: false }, class: "#{card_classes} focus:outline-none ring-2 ring-transparent hover:ring-offset-2 hover:ring-primary-300 dark:hover:ring-primary-900 hover:border-transparent focus:border-transparent focus:ring-2 ring-offset-gray-200 dark:ring-offset-gray-950 focus:ring-offset-2 focus:ring-offset-gray-200 dark:focus:ring-offset-gray-950 focus:ring-primary-500 focus:border-transparent active:ring-primary-500 dark:active:ring-primary-500 active:border-transparent transition-color duration-150 p-6" do %>
              <div class="flex flex-col gap-4 h-full">
                <div class="flex items-center gap-4">
                  <div class="flex-shrink-0">
                    <div class="w-16 h-16 rounded-lg bg-gray-100 dark:bg-gray-700 flex items-center justify-center p-3">
                      <%= image_tag plugin.image_url, alt: plugin.name, class: 'dark:hidden w-full h-full object-contain' %>
                      <%= image_tag plugin.image_dark_url, alt: plugin.name, class: 'hidden dark:block w-full h-full object-contain' %>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-medium text-gray-900 dark:text-white"><%= config[:name] %></h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= plugin.description %></p>
                  </div>
                </div>
                <p class="text-sm text-gray-550 dark:text-gray-500"><%= config[:description] %></p>
                <div class="flex items-center gap-2 mt-auto pt-2 text-sm text-syntax-string">
                  <span>View examples</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>

    <%= render 'framework_v2/page_navigation' %>
  </div>
</div>
