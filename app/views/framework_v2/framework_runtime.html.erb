<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework_v2/page_header', page_name: :framework_runtime %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:framework_runtime) %>

    <div class="space-y-16">
      <section class="space-y-6">
        <%= framework_heading(3, 'What it does') %>
        <p class="<%= framework_section_description_classes %>">At a high level, it measures the space you have and then plans columns, clamps text, formats and fits values, and adjusts gaps and index widths - so everything fits neatly without manual tweaking.</p>
        <ul class="list-disc list-inside space-y-2 <%= framework_list_classes %>">
          <li>Normalizes screen context (size, orientation, bit depth, scale)</li>
          <li>Maps legacy responsive classes to data attributes for consistency</li>
          <li>Formats values and fits numbers into their containers</li>
          <li>Adjusts gaps so columns/grids land on integer pixel widths</li>
          <li>Plans multi-column layouts, re-clamps text per column, and can add a trailing “and N more” label when enabled</li>
          <li>Applies standalone clamping where needed outside columns</li>
          <li>Limits overly tall content and schedules pixel-perfect text processing</li>
        </ul>
      </section>

      <section class="space-y-6">
        <%= framework_heading(3, 'Runtime steps and stats') %>
        <p class="<%= framework_section_description_classes %>">When the runtime executes, it performs these steps in order.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <%= render FrameworkDocCardComponent.new(icon: :clamp, title: 'Clamp', docs_page: :clamp) do %>
            <p class="<%= framework_subsection_description_classes %>">Clamps text to N lines.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Word‑based ellipsis</li>
              <li>Preserves original text</li>
              <li>Re‑clamps when widths change</li>
              <li>Supports responsive data attributes (size/orientation)</li>
              <li>Maps legacy class utilities to <code class="<%= framework_section_code_classes %>">data-clamp</code></li>
              <li>Applies outside and inside columns (per‑column re‑clamp handled by Overflow)</li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :overflow, title: 'Overflow', docs_page: :overflow) do %>
            <p class="<%= framework_subsection_description_classes %>">Plans 1..N columns with off‑screen staging and commits the best fit, then re‑clamps per real column width.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Duplicates group headers across columns when needed</li>
              <li>Optional trailing “and N more” label for hidden items (enable with <code class="<%= framework_section_code_classes %>">data-overflow-counter="true"</code>)</li>
              <li>Enforces final fit by hiding trailing items if necessary</li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :format_value, title: 'Value Formatting', docs_page: :format_value) do %>
            <p class="<%= framework_subsection_description_classes %>">Formats numbers to fit available space and abbreviates as needed (k, M, B).</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Respects <code class="<%= framework_section_code_classes %>">data-value-locale</code></li>
              <li>Works with <code class="<%= framework_section_code_classes %>">data-fit-value</code> for auto‑sizing</li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :fit_value, title: 'Fit Value', docs_page: :fit_value) do %>
            <p class="<%= framework_subsection_description_classes %>">Adjusts font size, line‑height, and weight to fit numbers within their containers.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Minimum font size safeguard (default 8px)</li>
              <li>Accepts <code class="<%= framework_section_code_classes %>">data-fit-value</code> or <code class="<%= framework_section_code_classes %>">data-value-fit</code></li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :grid, title: 'Grid Gaps', docs_page: :grid) do %>
            <p class="<%= framework_subsection_description_classes %>">Tweaks CSS gaps so grid column widths resolve to integer pixels.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Disable with <code class="<%= framework_section_code_classes %>">data-adjust-grid-gaps="false"</code></li>
              <li>Falls back to measuring child positions when <code class="<%= framework_section_code_classes %>">gap</code> is not explicitly set</li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :columns, title: 'Column Gaps', docs_page: :columns) do %>
            <p class="<%= framework_subsection_description_classes %>">Normalizes gaps between <code class="<%= framework_section_code_classes %>">.column</code> elements so column widths are integers.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Disable with <code class="<%= framework_section_code_classes %>">data-adjust-column-gaps="false"</code></li>
              <li>Runs as a pre‑pass for non‑overflow columns and a final pass after Overflow</li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :pixel_perfect, title: 'Pixel‑Perfect Fonts', docs_page: :pixel_perfect) do %>
            <p class="<%= framework_subsection_description_classes %>">Wraps lines in spans and enforces even/odd widths for crisp rendering; scheduled in idle time.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Skipped on higher bit‑depth modes</li>
              <li>Respects centered alignment</li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :content_limiter, title: 'Content Limiter', docs_page: :content_limiter) do %>
            <p class="<%= framework_subsection_description_classes %>">Constrains content height by view type or explicit threshold and flags small content.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Override via <code class="<%= framework_section_code_classes %>">data-content-max-height</code></li>
              <li>Adds <code class="<%= framework_section_code_classes %>">content--small</code> and <code class="<%= framework_section_code_classes %>">clamp--N</code> classes</li>
            </ul>
          <% end %>

          <%= render FrameworkDocCardComponent.new(icon: :label, title: 'Index Widths', docs_page: :item) do %>
            <p class="<%= framework_subsection_description_classes %>">Ensures item index badges render at even widths to avoid artifacts.</p>
            <ul class="list-disc list-inside space-y-1 <%= framework_list_classes %>">
              <li>Observes width changes and adjusts without feedback loops</li>
              <li>Runs after column layouts commit to cover in‑column indices</li>
            </ul>
          <% end %>
        </div>
      </section>

      <section class="space-y-6">
        <%= framework_heading(3, 'Why this exists') %>
        <p class="<%= framework_section_description_classes %>">Plugins need to fit source data into a static layout space that is device‑defined and varies by model, orientation, and density. While this resembles responsive web design, the runtime provides purpose‑built tools—overflow planning, per‑column clamping, integer pixel alignment, and value fitting—tailored specifically for TRMNL devices.</p>
      </section>

      <%= render 'framework_v2/page_navigation' %>
    </div>
  </div>
</div>

