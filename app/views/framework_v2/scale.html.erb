      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'How It Works') %>
          <p class="<%= framework_section_description_classes %>">
            The scale system works by modifying the <code class="<%= framework_section_code_classes %>">--ui-scale</code> CSS variable, which is used throughout the framework to calculate sizes.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Affected Properties') %>
            <p class="<%= framework_subsection_description_classes %>">
              When you apply a scale modifier, it scales the following properties:
            </p>
          </div>

            <ul class="list-disc list-inside space-y-2 <%= framework_list_classes %>">
            <li>Font sizes (all text elements)</li>
            <li>Line heights</li>
            <li>Component dimensions (title bar height, progress bar sizes, etc.)</li>
            <li>Spacing that uses the ui-scale multiplier</li>
            <li>Any custom properties that reference <code class="<%= framework_section_code_classes %>">var(--ui-scale)</code></li>
          </ul>

          <div class="<%= message_sage_classes %>">
            <div class="flex items-center w-full">
              <div class="flex-shrink-0 items-center">
                <%= render 'shared/icons/info' %>
              </div>
              <div class="w-full flex items-center justify-between ml-3">
                <p class="text-sm font-medium">
                  <strong>Note:</strong> The scale utility only affects elements that use the <code class="<%= framework_section_code_classes %>">--ui-scale</code> variable in their calculations. Fixed pixel values and screen dimensions remain unchanged.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Combining with Device Configurations') %>
          <p class="<%= framework_section_description_classes %>">
            Scale modifiers can be combined with device-specific classes to override the default UI scale for particular devices.
          </p>
        </div>

        <div class="space-y-6">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
              <thead class="bg-gray-50 dark:bg-gray-800">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Class Combination</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Description</th>
                </tr>
              </thead>
              <tbody class="bg-white dark:bg-gray-900 divide-y divide-gray-200 dark:divide-gray-700">
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <code class="text-sm font-mono text-syntax-string">screen screen--v2</code>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    Uses device default scale
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <code class="text-sm font-mono text-syntax-string">screen screen--v2 screen--scale-small</code>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    Overrides to 87.5% scale
                  </td>
                </tr>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <code class="text-sm font-mono text-syntax-string">screen screen--amazon_kindle_2024 screen--scale-large</code>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                    Overrides to 112.5% scale
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="mt-4">
            <%= render CodeExampleComponent.new(
              demo_code: '<!-- Use device default UI scale -->
<div class="screen screen--v2">
  <!-- Content -->
</div>

<!-- Override device scale with scale modifier -->
<div class="screen screen--v2 screen--scale-small">
  <!-- Content at 87.5% scale -->
</div>

<!-- Combine with any device configuration -->
<div class="screen screen--amazon_kindle_2024 screen--scale-large">
  <!-- Kindle device with 112.5% scale -->
</div>'
            ) %>
          </div>
        </div>
      </section>

      <%= render 'framework_v2/page_navigation' %>
    </div>
  </div>
</div> 
