<div class="<%= layout_framework_classes %>">
  <div class="<%= layout_framework_title_classes %>">
    <%= render 'framework_v2/page_header', page_name: :title_bar %>
  </div>

  <div class="<%= layout_framework_content_classes %>">
    <%= render_framework_intro_paragraph(:title_bar) %>

    <div class="space-y-16">
      <%= render FrameworkComparisonComponent.new(variant: :do_vs_dont) do |c| %>
        <% c.with_left_message do %>
          <p class="text-sm font-medium">Place Title Bar as a sibling of Layout inside a View. Both <code class="<%= framework_section_code_classes %>">layout</code> and <code class="<%= framework_section_code_classes %>">title_bar</code> should be direct children of the view.</p>
        <% end %>
        <% c.with_right_message do %>
          <p class="text-sm font-medium">Don't nest Title Bar inside Layout. <code class="<%= framework_section_code_classes %>">title_bar</code> and <code class="<%= framework_section_code_classes %>">layout</code> must be siblings, not parent and child.</p>
        <% end %>
        <% c.with_left_code do %>
          <%= render CodeExampleComponent.new(
            demo_code: <<~'HTML'.strip,
              <!-- view view--full (platform-provided) -->
              <div class="layout">...</div>
              <div class="title_bar">...</div>
              <!-- /view -->
            HTML
            extra_classes: '!rounded-t-none'
          ) %>
        <% end %>
        <% c.with_right_code do %>
          <%= render CodeExampleComponent.new(
            demo_code: <<~'HTML'.strip,
              <!-- view view--full (platform-provided) -->
              <div class="layout">
                <div class="title_bar">...</div>
              </div>
              <!-- /view -->
            HTML
            extra_classes: '!rounded-t-none'
          ) %>
        <% end %>
      <% end %>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Base Structure') %>
          <p class="<%= framework_section_description_classes %>">
            The Title Bar <%= render DocsRef.new(page: :title_bar) %> consists of three main elements: an icon <%= render DocsRef.new(page: :image) %>, a title <%= render DocsRef.new(page: :title) %>, and an optional instance label <%= render DocsRef.new(page: :label) %>. These elements are arranged horizontally and automatically spaced.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Basic Title Bar') %>
            <p class="<%= framework_subsection_description_classes %>">
              The basic Title Bar includes an icon and title. Use the <code class="<%= framework_section_code_classes %>">title_bar</code> class <%= render DocsRef.new(page: :title_bar) %>
              for the container.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout"></div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                      <span class="title">Basic Title Bar</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%= render CodeExampleComponent.new(
            demo_code: '<div class="title_bar">
  <img class="image" src="/images/plugins/trmnl--render.svg">
  <span class="title">Basic Title Bar</span>
</div>'
          ) %>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Title Bar with Instance') %>
            <p class="<%= framework_subsection_description_classes %>">
              Add an instance label using the <code class="<%= framework_section_code_classes %>">instance</code> class
              to display additional context.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="view view--full">
                    <div class="layout"></div>
                    <div class="title_bar">
                      <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                      <span class="title">Title Bar with Instance</span>
                      <span class="instance">Production</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%= render CodeExampleComponent.new(
            demo_code: '<div class="title_bar">
  <img class="image" src="/images/plugins/trmnl--render.svg">
  <span class="title">Title Bar with Instance</span>
  <span class="instance">Production</span>
</div>'
          ) %>
        </div>
      </section>

      <section class="space-y-8">
        <div class="space-y-4">
          <%= framework_heading(3, 'Title Bar in Mashups') %>
          <p class="<%= framework_section_description_classes %>">
            When the Title Bar is placed inside a <%= render DocsRef.new(page: :mashup) %>, it automatically receives different styling. Inside a view with a mashup layout (<code class="<%= framework_section_code_classes %>">view--half_vertical</code>, <code class="<%= framework_section_code_classes %>">view--half_horizontal</code>, or <code class="<%= framework_section_code_classes %>">view--quadrant</code>), the title bar uses a reduced height, a smaller icon, and no top or side border radius, with rounded bottom corners only so it aligns with the view's bordered outline.
          </p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <%= framework_heading(4, 'Example') %>
            <p class="<%= framework_subsection_description_classes %>">
              The same <code class="<%= framework_section_code_classes %>">title_bar</code> markup is used; the framework applies the compact styling automatically when the title bar is inside a mashup view.
            </p>
          </div>

          <div class="<%= framework_example_classes %>">
            <div class="<%= framework_example_inner_classes %>">
              <div class="<%= framework_example_wrapper_classes %>">
                <div class="screen">
                  <div class="mashup mashup--1Lx1R">
                    <div class="view view--half_vertical">
                      <div class="layout">
                        <span class="label">Plugin A</span>
                      </div>
                      <div class="title_bar">
                        <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                        <span class="title">Calendar</span>
                      </div>
                    </div>
                    <div class="view view--half_vertical">
                      <div class="layout">
                        <span class="label">Plugin B</span>
                      </div>
                      <div class="title_bar">
                        <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Logo" %>
                        <span class="title">RSS</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%= render CodeExampleComponent.new(
            demo_code: '<div class="mashup mashup--1Lx1R">
  <div class="view view--half_vertical">
    <div class="layout">
      <span class="label">Plugin A</span>
    </div>
    <div class="title_bar">
      <img class="image" src="/images/plugins/trmnl--render.svg">
      <span class="title">Calendar</span>
    </div>
  </div>
  <div class="view view--half_vertical">
    <div class="layout">
      <span class="label">Plugin B</span>
    </div>
    <div class="title_bar">
      <img class="image" src="/images/plugins/trmnl--render.svg">
      <span class="title">RSS</span>
    </div>
  </div>
</div>'
          ) %>
        </div>
      </section>
      <%= render 'framework_v2/page_navigation' %>
    </div>
  </div>
</div>
