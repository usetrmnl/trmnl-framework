<div id="<%= visual_id %>" class="trmnl visual-composition-frame" data-visual>
  <div class="screen screen--og screen--landscape <%= screen_classes %> visual-composition-screen">
    <div class="view view--full">
      <div class="layout layout--col gap--space-between">
        <div class="grid grid--cols-3 gap--medium">
          <div class="item rounded bg--gray-70 p--3">
            <div class="content">
              <span class="value value--large value--tnums">42</span>
              <span class="label label--small">Open PRs</span>
            </div>
          </div>
          <div class="item rounded bg--gray-55 p--3">
            <div class="content">
              <span class="value value--large value--tnums">98%</span>
              <span class="label label--small">Checks passing</span>
            </div>
          </div>
          <div class="item rounded outline p--3">
            <div class="content">
              <span class="value value--large value--tnums">3.2</span>
              <span class="label label--small">Framework</span>
            </div>
          </div>
        </div>

        <div class="divider"></div>

        <div class="columns gap--large">
          <div class="column gap--medium">
            <div class="item">
              <div class="meta"></div>
              <div class="content">
                <span class="title title--small">Runtime suite</span>
                <span class="description">Behavioral coverage in Chromium</span>
              </div>
            </div>
            <div class="item">
              <div class="meta"></div>
              <div class="content">
                <span class="title title--small">Visual suite</span>
                <span class="description">Paint and component baselines</span>
              </div>
            </div>
          </div>
          <div class="column gap--large">
            <div class="progress-bar progress-bar--emphasis-2">
              <div class="content">
                <span class="label">Launch checklist</span>
                <span class="label">75%</span>
              </div>
              <div class="track"><div class="fill" style="width: 75%"></div></div>
            </div>
            <div class="progress-dots">
              <div class="content"><span class="label">Release stages</span></div>
              <div class="track">
                <div class="dot dot--filled"></div>
                <div class="dot dot--filled"></div>
                <div class="dot dot--current"></div>
                <div class="dot"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="title_bar">
        <span class="title">Framework readiness</span>
        <span class="instance">Local verification</span>
      </div>
    </div>
  </div>
</div>
