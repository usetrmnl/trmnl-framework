<% border_modes = [
  ['borders-1bit', 'screen--1bit'],
  ['borders-1bit-dark', 'screen--1bit screen--dark-mode'],
  ['borders-2bit', 'screen--2bit'],
  ['borders-color-4bwry', 'screen--color-4bwry screen--preview-colors'],
  ['borders-theme-black-yellow', 'screen--color-4bwry screen--preview-colors screen--theme-black-and-yellow'],
  ['borders-theme-white-red', 'screen--color-4bwry screen--preview-colors screen--theme-white-and-red'],
  ['borders-theme-dark', 'screen--color-4bwry screen--preview-colors screen--theme-dark'],
  ['borders-theme-dark-1bit', 'screen--1bit screen--theme-dark'],
  ['borders-theme-dark-2bit', 'screen--2bit screen--theme-dark'],
  ['borders-theme-dark-2bit-color-7a', 'screen--2bit screen--color-7a screen--theme-dark']
] %>
<% border_steps = [10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70, 75] %>

<style>
  .visual-border-screen {
    position: relative !important;
    display: grid !important;
    grid-template-columns: 1fr 1fr 180px;
    gap: 16px;
    width: 800px !important;
    height: 360px !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 16px !important;
    box-sizing: border-box;
    transform: none !important;
  }

  .visual-border-frame {
    width: 800px;
    height: 360px;
  }

  .visual-border-column {
    display: grid;
    grid-template-rows: repeat(14, 1fr);
    gap: 4px;
    min-width: 0;
    padding: 12px;
  }

  .visual-border-rail {
    position: relative;
    min-height: 0;
  }

  .visual-border-verticals {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 8px;
    padding: 12px;
  }

  .visual-divider-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: 1fr auto 1fr;
    min-height: 0;
    background: inherit;
  }

  .visual-divider-grid .divider {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .visual-divider-grid .divider--v {
    grid-column: 2;
    grid-row: 1 / -1;
  }
</style>

<main class="visual-page" data-visual-ready="true">
  <% border_modes.each do |visual_id, mode_classes| %>
    <div id="<%= visual_id %>" class="trmnl visual-border-frame" data-visual>
      <div class="screen screen--og screen--landscape <%= mode_classes %> visual-border-screen">
      <div class="visual-border-column bg--white">
        <% border_steps.each do |step| %>
          <div class="visual-border-rail border--h-<%= step %>"></div>
        <% end %>
      </div>

      <div class="visual-border-column bg--black">
        <% border_steps.each do |step| %>
          <div class="visual-border-rail border--h-<%= step %>"></div>
        <% end %>
      </div>

        <div class="visual-border-column bg--gray-70">
        <div class="visual-border-verticals" style="grid-row: 1 / span 7">
          <% border_steps.each_slice(2).map(&:first).each do |step| %>
            <div class="border--v-<%= step %>"></div>
          <% end %>
        </div>
        <div class="visual-divider-grid" style="grid-row: 8 / -1">
          <div class="divider"></div>
          <div class="divider--v"></div>
        </div>
        </div>
      </div>
    </div>
  <% end %>
</main>
