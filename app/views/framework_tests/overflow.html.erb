<% variants = [
  { classes: 'screen screen--og screen--landscape' },
  { classes: 'screen screen--og screen--portrait' },
  { classes: 'screen screen--v2 screen--4bit screen--lg screen--landscape' },
  { classes: 'screen screen--v2 screen--4bit screen--lg screen--portrait' }
] %>

<%# Example 1: Overflow: single column (data-overflow-max-cols=1) %>
<div style="font-size: 32px; font-weight: bold; margin: 30px 0;">Overflow: Max 1 Column (no clamp)</div>
<% variants.each_with_index do |variant, idx| %>
  <div class="example trmnl">
    <div class="<%= variant[:classes] %>">
      <div class="view view--full">
        <div class="layout layout--col">
          <div class="columns" data-overflow-max-cols="1">
            <div class="column">
              <% overflow_demo_content[:extended_tasks].each do |task| %>
                <%= render_task_item(task) %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="title_bar">
          <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Plugin Icon" %>
          <span class="title">Overflow</span>
          <span class="instance">No clamp, Max 1 Column</span>
        </div>
      </div>
    </div>
  </div>
<% end %>

<hr>

<%# Example 7: Overflow + Clamp: Mixed (Title 1 + Description 3), Max 2 Columns %>
<div style="font-size: 32px; font-weight: bold; margin: 30px 0;">Overflow + Clamp: Mixed, Max 2 Columns (Title 1 + Description 3)</div>
<% variants.each_with_index do |variant, idx| %>
  <div class="example trmnl">
    <div class="<%= variant[:classes] %>">
      <div class="view view--full">
        <div class="layout layout--col">
          <div class="columns" data-overflow-max-cols="2">
            <div class="column">
              <% overflow_demo_content[:extended_tasks].each do |task| %>
                <%= render_task_item(task.merge(
                  title_attributes: { 'data-clamp': '1' },
                  description_attributes: { 'data-clamp': '3' }
                )) %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="title_bar">
          <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Plugin Icon" %>
          <span class="title">Overflow + Clamp</span>
          <span class="instance">Title 1 + Description 3, Max 2 Columns</span>
        </div>
      </div>
    </div>
  </div>
<% end %>

<hr>

