<%# Example 3: Grouped Headings: multi-column with duplicate headers and no dangling headers %>
<div style="font-size: 32px; font-weight: bold; margin: 30px 0;">Groups: Headings with spillover (no clamp)</div>
<% variants.each_with_index do |variant, idx| %>
  <div class="example trmnl">
    <div class="<%= variant[:classes] %>">
      <div class="view view--full">
        <div class="layout layout--col">
          <div class="columns" data-overflow-max-cols="3">
            <div class="column">
              <% groups = overflow_grouped_from_extended_tasks %>
              <%= render_group_header("Today") %>
              <% groups[:today].each do |task| %>
                <%= render_task_item(task) %>
              <% end %>

              <%= render_group_header("Tomorrow") %>
              <% groups[:tomorrow].each do |task| %>
                <%= render_task_item(task) %>
              <% end %>

              <%= render_group_header("This Week") %>
              <% groups[:this_week].each do |task| %>
                <%= render_task_item(task) %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="title_bar">
          <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Plugin Icon" %>
          <span class="title">Groups</span>
          <span class="instance">Duplicate spill headers, no dangling headers</span>
        </div>
      </div>
    </div>
  </div>
<% end %>

<hr>

