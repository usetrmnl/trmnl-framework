<%# Example 5: Standalone Clamp: outside of .columns %>
<div style="font-size: 32px; font-weight: bold; margin: 30px 0;">Clamp: Description (Standalone 1–4 lines)</div>
<% variants.each_with_index do |variant, idx| %>
  <div class="example trmnl">
    <div class="<%= variant[:classes] %>">
      <div class="view view--full">
        <div class="layout layout--col">
          <div class="item">
            <div class="content">
              <span class="title title--small">Long description (1 lines)</span>
              <span class="description" data-clamp="1">
                This is a very long standalone description used to verify the clamp engine in isolation. It repeats concepts to guarantee overflow so truncation is visible and predictable across widths and fonts. The purpose is to be long enough to always require clamping. This is a very long standalone description used to verify the clamp engine in isolation. It repeats concepts to guarantee overflow so truncation is visible and predictable across widths and fonts. The purpose is to be long enough to always require clamping.
              </span>
            </div>
          </div>
          <div class="item">
            <div class="content">
              <span class="title title--small">Long description (2 lines)</span>
              <span class="description" data-clamp="2">
                This is a very long standalone description used to verify the clamp engine in isolation. It repeats concepts to guarantee overflow so truncation is visible and predictable across widths and fonts. The purpose is to be long enough to always require clamping. This is a very long standalone description used to verify the clamp engine in isolation. It repeats concepts to guarantee overflow so truncation is visible and predictable across widths and fonts. The purpose is to be long enough to always require clamping.
              </span>
            </div>
          </div>
          <div class="item">
            <div class="content">
              <span class="title title--small">Long description (3 lines)</span>
              <span class="description" data-clamp="3">
                Another extensive paragraph to ensure clamping works reliably over varying widths and fonts. It preserves original content in data-clamp-original, recalculates single-line height accurately, and trims by words before appending an ellipsis. The text is intentionally 3× longer to force clamping in all variants. Another extensive paragraph to ensure clamping works reliably over varying widths and fonts. It preserves original content in data-clamp-original, recalculates single-line height accurately, and trims by words before appending an ellipsis.
              </span>
            </div>
          </div>
          <div class="item">
            <div class="content">
              <span class="title title--small">Long description (4 lines)</span>
              <span class="description" data-clamp="4">
                This block validates four-line clamping. It contains sufficient length to exceed four lines in every screen variant, ensuring the engine truncates at the correct boundary with a word-based ellipsis. The goal is deterministic truncation regardless of column widths or device scale. This block validates four-line clamping. It contains sufficient length to exceed four lines in every screen variant, ensuring the engine truncates at the correct boundary with a word-based ellipsis. The goal is deterministic truncation regardless of column widths or device scale.
              </span>
            </div>
          </div>
        </div>
        <div class="title_bar">
          <%= image_tag plugin_image_path("trmnl--render.svg"), class: "image", alt: "TRMNL Plugin Icon" %>
          <span class="title">Clamp</span>
          <span class="instance">Standalone: Description 1–4 lines</span>
        </div>
      </div>
    </div>
  </div>
<% end %>

