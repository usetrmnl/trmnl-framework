<% if @split_header %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
    <div class="space-y-4">
      <%= helpers.framework_heading(3, @title) %>
      <% if @description.present? %>
        <p class="<%= helpers.framework_section_description_classes %> !mb-4">
          <%= @description %>
        </p>
      <% end %>
    </div>
    <div class="lg:col-span-2 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @pages.each do |page| %>
          <%= render 'framework/framework_card',
            url: helpers.framework_page_path(page),
            page: page,
            title: helpers.page_titles[page] || page.to_s.titleize,
            description: helpers.page_description(page),
            compact: compact? %>
        <% end %>
      </div>
      <% if @omitted_count.positive? %>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          and <%= @omitted_count %> more
        </p>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="space-y-4">
    <%= helpers.framework_heading(3, @title) %>
    <% if @description.present? %>
      <p class="<%= helpers.framework_section_description_classes %> !mb-4">
        <%= @description %>
      </p>
    <% end %>
    <div class="grid grid-cols-1 <%= compact? ? compact_grid_classes : 'gap-6' %>">
      <% @pages.each do |page| %>
        <%= render 'framework/framework_card',
          url: helpers.framework_page_path(page),
          page: page,
          title: helpers.page_titles[page] || page.to_s.titleize,
          description: helpers.page_description(page),
          compact: compact? %>
      <% end %>
    </div>
    <% if @omitted_count.positive? %>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
        and <%= @omitted_count %> more
      </p>
    <% end %>
  </div>
<% end %>
